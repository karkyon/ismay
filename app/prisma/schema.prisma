// ISMAY schema.prisma
// DB設計書v1.1 3章「テーブル一覧」の TBL-001〜026 を反映。
// 列定義が正式資料に明記されていない部分は [推論] とコメントし、次回レビュー対象とする。
// 認証方式は「OIDC準拠（システム基本設計書v1.2 7章）」の決定に基づき、
// 自前のセッション・リフレッシュトークン・TOTP MFAテーブルを新設する（TBD-02準拠実装）。
//
// 生成: `npx prisma generate`
// 適用: `npx prisma migrate dev --name init_core_schema`

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

// =====================================================================
// MOD-01 Identity: users / workspaces / workspace_members / domains
// =====================================================================

/// TBL-001 users - 本人アカウント
model User {
  id                        String    @id @default(uuid())
  email                     String    @unique
  emailVerifiedAt           DateTime? @map("email_verified_at")
  passwordHash              String    @map("password_hash")
  displayName               String?   @map("display_name")
  locale                    String    @default("ja-JP")
  timeZone                  String    @default("Asia/Tokyo") @map("time_zone")
  /// ACTIVE/SUSPENDED/DELETED [推論]
  status                    String    @default("ACTIVE")
  /// FN-NTF-01 通知設定: 静穏時間帯の開始("HH:MM"、timeZone基準)。null=静穏時間なし [新設・推論]
  notifyQuietHoursStart     String?   @map("notify_quiet_hours_start")
  /// FN-NTF-01 通知設定: 静穏時間帯の終了("HH:MM"、timeZone基準)。開始>終了の場合は日をまたぐ扱い [新設・推論]
  notifyQuietHoursEnd       String?   @map("notify_quiet_hours_end")
  /// FN-NTF-01 通知設定: まとめ通知の時間窓(分)。この間隔単位でscheduledAtを丸め、近接通知を束ねる [新設・推論]
  notifyBundleWindowMinutes Int       @default(15) @map("notify_bundle_window_minutes")
  /// FN-NTF-01 通知設定(2026-08-22追加): 種別ごとの受信可否(GitHub「Watching/
  /// Participating/Custom」の粒度選択に相当)。既定は全種別ON。
  notifyDeadlineEnabled     Boolean   @default(true) @map("notify_deadline_enabled")
  notifyFollowUpEnabled     Boolean   @default(true) @map("notify_follow_up_enabled")
  notifyRiskEnabled         Boolean   @default(true) @map("notify_risk_enabled")
  version                   Int       @default(0)
  createdAt                 DateTime  @default(now()) @map("created_at")
  updatedAt                 DateTime  @updatedAt @map("updated_at")
  deletedAt                 DateTime? @map("deleted_at")

  workspaceMembers                       WorkspaceMember[]
  sessions                               UserSession[]
  totpSecret                             UserTotpSecret?
  capturesCreated                        Capture[]                         @relation("CaptureCreatedBy")
  responsibilitiesCreated                Responsibility[]                  @relation("ResponsibilityCreatedBy")
  responsibilitiesUpdated                Responsibility[]                  @relation("ResponsibilityUpdatedBy")
  pemObservations                        PemObservation[]
  pemHypotheses                          PemHypothesis[]
  pemOnboardingConversations             PemOnboardingConversation[]
  pemWeeklyReviews                       PemWeeklyReview[]
  pemConsentEvents                       PemConsentEvent[]
  pemMetricConsentEvents                 PemMetricConsentEvent[]
  pemEvidenceDeletionEvents              PemEvidenceDeletionEvent[]
  bootstrapAssertions                    BootstrapAssertion[]
  notifications                          Notification[]
  auditLogsAsActor                       AuditLog[]                        @relation("AuditActorUser")
  /// [V5-M1-A1新設] Context本人(観測対象)としての逆relation。
  projectContextsOwned                   ProjectContext[]                  @relation("ProjectContextOwner")
  /// [V5-M1-B1新設] FormationSession.subjectUserId、および各append-only Eventの
  /// actorUserIdからの参照先として必要(全て単一のUser関係のためrelation名の
  /// disambiguationは不要。ProjectContextOwner/CreatedByのような複数関係が
  /// 同一model内に無いため)。
  formationSessionsAsSubject             FormationSession[]
  formationSessionEventsAsActor          FormationSessionEvent[]
  formationAnswerEventsAsActor           FormationAnswerEvent[]
  formationCandidateDecisionsAsActor     FormationCandidateDecisionEvent[]
  /// [2026-08-30新設・M1-C2A] FormationAtomicityOverride.actorUserId逆参照。
  formationAtomicityOverridesAsActor     FormationAtomicityOverride[]
  /// [2026-08-30新設・M1-C2B] FormationCandidateMergeEvent.actorUserId逆参照。
  formationCandidateMergeEventsAsActor   FormationCandidateMergeEvent[]
  /// [M1-B6B新設・2026-08-31指示書 Session Lifecycle]
  formationSessionLifecycleEventsAsActor FormationSessionLifecycleEvent[]
  /// [V5-M1-A1新設] Context作成者としての逆relation。
  projectContextsCreated                 ProjectContext[]                  @relation("ProjectContextCreatedBy")

  @@map("users")
}

/// FR-AUTH-04対応: セッション・端末の確認/失効。OIDC Access/Refresh運用の実体。[新設・推論]
model UserSession {
  id                 String    @id @default(uuid())
  userId             String    @map("user_id")
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceLabel        String?   @map("device_label")
  userAgent          String?   @map("user_agent")
  ipAddress          String?   @map("ip_address")
  /// Refresh Tokenはハッシュのみ保存し、平文は保持しない
  refreshTokenHash   String    @map("refresh_token_hash")
  /// ローテーション世代を束ねる系列ID。再利用検知（Token再送攻撃対策）に使用
  refreshTokenFamily String    @map("refresh_token_family")
  issuedAt           DateTime  @default(now()) @map("issued_at")
  lastUsedAt         DateTime  @default(now()) @map("last_used_at")
  expiresAt          DateTime  @map("expires_at")
  revokedAt          DateTime? @map("revoked_at")
  revokedReason      String?   @map("revoked_reason")

  @@index([userId, revokedAt])
  @@index([refreshTokenFamily])
  @@map("user_sessions")
}

/// FR-AUTH-03対応: TOTP MFA秘密鍵と復旧コード。[新設・推論]
model UserTotpSecret {
  id                String    @id @default(uuid())
  userId            String    @unique @map("user_id")
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// アプリ層AES-256-GCM等で暗号化して保存（TBD-17の決定に従う）
  secretEncrypted   String    @map("secret_encrypted")
  /// リカバリコードはハッシュ化して配列保存。使用済みは別途 usedAt を持つ小テーブル化も検討可
  recoveryCodesHash Json      @map("recovery_codes_hash")
  enrolledAt        DateTime  @default(now()) @map("enrolled_at")
  disabledAt        DateTime? @map("disabled_at")

  @@map("user_totp_secrets")
}

/// TBL-002 workspaces - データ所有境界 [推論]
model Workspace {
  id        String    @id @default(uuid())
  name      String
  version   Int       @default(0)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  members               WorkspaceMember[]
  domains               Domain[]
  captures              Capture[]
  responsibilities      Responsibility[]
  integrations          Integration[]
  aiProviderConfigs     AiProviderConfig[]
  aiProviderCredentials AiProviderCredential[]
  tags                  Tag[]
  cycles                Cycle[]
  /// [V5-M1-A1新設]
  projectContexts       ProjectContext[]
  /// [V5-M1-B1新設]
  formationSessions     FormationSession[]

  @@map("workspaces")
}

/// TBL-003 workspace_members - 所属・ロール（履歴保持）[推論]
model WorkspaceMember {
  id          String    @id @default(uuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// OWNER/ADMIN/MEMBER [推論]
  role        String    @default("MEMBER")
  joinedAt    DateTime  @default(now()) @map("joined_at")
  leftAt      DateTime? @map("left_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([workspaceId, userId])
  @@map("workspace_members")
}

/// TBL-004 domains - 仕事・個人等の機密境界 [推論]
model Domain {
  id          String    @id @default(uuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  /// WORK/PERSONAL/OTHER [推論]
  kind        String    @default("PERSONAL")
  /// AI参照可否等のポリシー [推論]
  aiPolicy    Json?     @map("ai_policy")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  captures          Capture[]
  responsibilities  Responsibility[]
  /// [V5-M1-A1新設] ProjectContextからの複合FK参照先として必要。
  projectContexts   ProjectContext[]
  /// [V5-M1-B1新設] FormationSessionからの複合FK参照先として必要。
  formationSessions FormationSession[]

  /// [V5-M1-A1新設・M1-A1指示書2.2節] ProjectContextからの複合FK
  /// (domainId, workspaceId)参照先として必要(既存は単一列PKのみだった)。
  @@unique([id, workspaceId], map: "domains_id_workspace_uq")
  @@map("domains")
}

// =====================================================================
// MOD-02 Capture
// =====================================================================

/// TBL-005 captures
model Capture {
  id                 String    @id @default(uuid())
  workspaceId        String    @map("workspace_id")
  workspace          Workspace @relation(fields: [workspaceId], references: [id])
  domainId           String?   @map("domain_id")
  domain             Domain?   @relation(fields: [domainId], references: [id])
  createdById        String    @map("created_by")
  createdBy          User      @relation("CaptureCreatedBy", fields: [createdById], references: [id])
  /// TEXT/VOICE/MEETING/IMPORT/IMAGE (IMAGE: 2026-08-21新設。会議メモ写真等のOCR文字起こし対応。
  /// FR-CAP-02「画像」将来用途の前倒し実装)
  sourceType         String    @map("source_type")
  rawText            String?   @map("raw_text")
  audioObjectKey     String?   @map("audio_object_key")
  /// 新設(2026-08-21): 画像OCR用。MinIO格納キー。audioObjectKeyと同じ設計方針
  /// (workspaceId/captureId/元ファイル名)。バケットは音声と共用する。
  imageObjectKey     String?   @map("image_object_key")
  /// 新設(2026-08-21): AIによる原文全体の一言要約。Inbox一覧で原文の機械的な
  /// 切り詰め表示の代わりに使う(カルキョンさんの指摘「タイトルと概要説明が
  /// 関連付けられるようになっているのか」への対応)。
  aiSummary          String?   @map("ai_summary")
  language           String    @default("ja-JP")
  /// SAVED/QUEUED/PROCESSING/READY/FAILED
  processingStatus   String    @default("SAVED") @map("processing_status")
  /// 新設(2026-08-21): REALTIME(即時)/BATCH(Anthropic Batch API、最大50%引き・完了まで
  /// 最大24時間)。ユーザーが取り込み時点で選択する(カルキョンさんの指示「緊急性の
  /// 高いのかバッチでいいのか選択させる」に対応)。音声の文字起こし(OpenAI)はBatch API
  /// 非対応のため、この列の値に関わらず常に即時実行する(OCR・AI抽出のみが対象)。
  processingPriority String    @default("REALTIME") @map("processing_priority")
  sourceCapturedAt   DateTime? @map("source_captured_at")
  consentId          String?   @map("consent_id")
  consent            Consent?  @relation(fields: [consentId], references: [id])
  /// API-CAP-01冪等キー(API・イベント設計書v1.1 4.1節: 「clientDraftId+userで冪等」)。[新設]
  clientDraftId      String?   @map("client_draft_id")
  /// 新設: このCaptureが音声の話題自動分割で生成された場合、分割元(1件目)のCapture.idを保持する。
  /// 1件目自体はこの列がnullのまま(rawTextが1つ目のセグメントに差し替えられる)。
  /// UI側で「分割された関連メモ」を辿るために使う(FN-CAP-01拡張、2026-08-21追加)。
  splitFromCaptureId String?   @map("split_from_capture_id")
  splitFromCapture   Capture?  @relation("CaptureSplit", fields: [splitFromCaptureId], references: [id])
  splitChildren      Capture[] @relation("CaptureSplit")
  version            Int       @default(0)
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")

  responsibilities           Responsibility[]
  aiInferences               AiInference[]
  aiRuns                     AiRun[]
  /// 新設: 画像OCRの複数ページ結合用(2026-08-21追加)。1枚のみの場合も1件作成する
  /// (imageObjectKey単体列は旧データ互換のためのみ残す。新規アップロードは常にこちら経由)。
  images                     CaptureImage[]
  /// [V5-M1-B1新設] FormationSession/FormationSourceAnchorからの複合FK参照先として必要。
  formationSessions          FormationSession[]
  formationSourceAnchors     FormationSourceAnchor[]
  /// [M1-B6C-1新設] FormationShadowCheckpointからの複合FK参照先として必要。
  formationShadowCheckpoints FormationShadowCheckpoint[]

  @@unique([workspaceId, createdById, clientDraftId], name: "captures_idempotency_key")
  /// [V5-M1-B1新設] FormationSession.captureId/FormationSourceAnchor.captureIdからの
  /// 複合FK(captureId, workspaceId)参照先として必要(既存は単一列PKのみだった。
  /// ProjectContext/Domain等と同じ理由・同じ命名規則)。
  @@unique([id, workspaceId], map: "captures_id_workspace_uq")
  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([processingStatus, updatedAt])
  @@map("captures")
}

/// 新設(2026-08-21): 画像OCRの複数ページ結合。TBL番号未採番。
/// 会議メモ・ノートを複数枚撮影した場合に、1つのCaptureへまとめて紐づける。
model CaptureImage {
  id        String   @id @default(uuid())
  captureId String   @map("capture_id")
  capture   Capture  @relation(fields: [captureId], references: [id])
  objectKey String   @map("object_key")
  /// 0始まり。OCR時にこの順でAnthropic Vision APIへ渡し、ページ順を保った
  /// 一つの書き起こしにまとめる。
  pageIndex Int      @map("page_index")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([captureId, pageIndex])
  @@map("capture_images")
}

// =====================================================================
// MOD-03 Responsibility
// =====================================================================

/// TBL-006 responsibilities - 全責任の共通正本
model Responsibility {
  id                         String                         @id @default(uuid())
  workspaceId                String                         @map("workspace_id")
  workspace                  Workspace                      @relation(fields: [workspaceId], references: [id])
  domainId                   String                         @map("domain_id")
  domain                     Domain                         @relation(fields: [domainId], references: [id])
  originCaptureId            String?                        @map("origin_capture_id")
  originCapture              Capture?                       @relation(fields: [originCaptureId], references: [id])
  /// 新設: AI採用によって生成された場合、元のAiInference.idを保持する。
  /// 同一Capture内の候補間依存関係(blockedByCandidateIds)をResponsibilityRelationへ
  /// 変換する際、「どの候補がどのResponsibilityになったか」を突き合わせるために使う。
  originInferenceId          String?                        @map("origin_inference_id")
  /// 新設(2026-08-21): PERT図でのノード位置(ドラッグして手動配置した場合に保存)。
  /// null時はフロント側の自動レイアウト(トポロジカル層)に従う。
  graphX                     Float?                         @map("graph_x")
  graphY                     Float?                         @map("graph_y")
  /// TASK/COMMITMENT/DECISION/WAITING/EVENT/RISK/CONCERN/HABIT/IDEA
  /// (v1.1注記: Constraintは含まない。Goalは本テーブルに現れない)
  type                       String
  title                      String
  description                String?
  status                     String
  importance                 Int?
  /// 0〜1
  confidence                 Decimal?                       @db.Decimal(4, 3)
  /// USER/AI/IMPORT/SYSTEM
  sourceKind                 String                         @map("source_kind")
  hardDeadlineAt             DateTime?                      @map("hard_deadline_at")
  targetAt                   DateTime?                      @map("target_at")
  startAfterAt               DateTime?                      @map("start_after_at")
  completedAt                DateTime?                      @map("completed_at")
  /// FN-WK-03「今日の最低ライン」(2026-08-22新設)。最大3件まで固定できる
  /// (件数上限はAPI側で強制する)。Reality Mode変更時の差分表示は未実装(将来対応)。
  pinned                     Boolean                        @default(false)
  pinnedAt                   DateTime?                      @map("pinned_at")
  version                    Int                            @default(0)
  eventSequenceCounter       Int                            @default(0) @map("event_sequence_counter")
  executionEvents            ResponsibilityExecutionEvent[]
  executionSessionIdentities ExecutionSessionIdentity[]
  /// [2026-08-25新設・Completion Gate 2.1、v4.0 8.1節] Correction/lifecycle記録。
  lifecycleEvents            ResponsibilityLifecycleEvent[]
  /// [2026-08-26新設・Undo Receipt] Bulk Complete Undoの正本レシート。
  bulkCompleteReceipts       BulkCompleteReceipt[]
  createdById                String                         @map("created_by")
  createdBy                  User                           @relation("ResponsibilityCreatedBy", fields: [createdById], references: [id])
  updatedById                String                         @map("updated_by")
  updatedBy                  User                           @relation("ResponsibilityUpdatedBy", fields: [updatedById], references: [id])
  createdAt                  DateTime                       @default(now()) @map("created_at")
  updatedAt                  DateTime                       @updatedAt @map("updated_at")
  deletedAt                  DateTime?                      @map("deleted_at")

  taskDetail                  TaskDetail?
  commitmentDetail            CommitmentDetail?
  decisionDetail              DecisionDetail?
  waitingDetail               WaitingDetail?
  constraints                 Constraint[]
  recurrenceRule              RecurrenceRule?
  relationsFrom               ResponsibilityRelation[]     @relation("RelationFrom")
  relationsTo                 ResponsibilityRelation[]     @relation("RelationTo")
  evidences                   Evidence[]
  embedding                   ResponsibilityEmbedding?
  tags                        ResponsibilityTag[]
  cycleItems                  CycleItem[]
  /// [V5-M1-A1新設]
  projectContextLinks         ProjectContextLink[]
  projectContextLinkEvents    ProjectContextLinkEvent[]
  /// [V5-M1-B1新設] MaterializationReceiptItemからの複合FK参照先として必要。
  materializationReceiptItems MaterializationReceiptItem[]

  /// [2026-08-24追加・Phase 0A是正2] ResponsibilityExecutionEventからの複合FK
  /// (responsibilityId, workspaceId)の参照先として必要(v4.0 4.1節「tenantを跨ぐ
  /// FK参照を禁止する」の機械的保証。既存の単一列idはunique(=PK)のため、
  /// この複合uniqueを追加しても他の参照方法に影響しない)。
  @@unique([id, workspaceId])
  @@index([workspaceId, id])
  @@map("responsibilities")
}

/// 新設(2026-08-21): タグ。Workspace単位。責任の分類・検索・PERT図での色分けに使う。
model Tag {
  id          String    @id @default(uuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  name        String
  /// 表示色(hex等)。UI側の既定色一覧から選ぶ想定。
  color       String    @default("#6b7280")
  createdAt   DateTime  @default(now()) @map("created_at")
  deletedAt   DateTime? @map("deleted_at")

  responsibilities ResponsibilityTag[]

  @@unique([workspaceId, name])
  @@map("tags")
}

/// 新設(2026-08-21): Responsibility×Tag多対多の中間テーブル。
model ResponsibilityTag {
  responsibilityId String         @map("responsibility_id")
  responsibility   Responsibility @relation(fields: [responsibilityId], references: [id], onDelete: Cascade)
  tagId            String         @map("tag_id")
  tag              Tag            @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now()) @map("created_at")

  @@id([responsibilityId, tagId])
  @@map("responsibility_tags")
}

/// TBL-007 task_details - Task固有属性 [推論]
model TaskDetail {
  responsibilityId    String         @id @map("responsibility_id")
  responsibility      Responsibility @relation(fields: [responsibilityId], references: [id], onDelete: Cascade)
  estimatedMinutesMin Int?           @map("estimated_minutes_min")
  estimatedMinutesMax Int?           @map("estimated_minutes_max")
  location            String?
  requiredTools       Json?          @map("required_tools")

  @@map("task_details")
}

/// TBL-008 commitment_details - 約束固有属性 [推論]
model CommitmentDetail {
  responsibilityId    String         @id @map("responsibility_id")
  responsibility      Responsibility @relation(fields: [responsibilityId], references: [id], onDelete: Cascade)
  counterpartyName    String?        @map("counterparty_name")
  counterpartyContact String?        @map("counterparty_contact")
  promiseText         String?        @map("promise_text")

  @@map("commitment_details")
}

/// TBL-009 decision_details - 判断固有属性 [推論]
model DecisionDetail {
  responsibilityId String         @id @map("responsibility_id")
  responsibility   Responsibility @relation(fields: [responsibilityId], references: [id], onDelete: Cascade)
  options          Json?
  chosenOption     String?        @map("chosen_option")
  rationale        String?
  decidedAt        DateTime?      @map("decided_at")

  @@map("decision_details")
}

/// TBL-010 waiting_details - 待ち固有属性 [推論]
model WaitingDetail {
  responsibilityId String         @id @map("responsibility_id")
  responsibility   Responsibility @relation(fields: [responsibilityId], references: [id], onDelete: Cascade)
  waitingOn        String?        @map("waiting_on")
  expectedReplyBy  DateTime?      @map("expected_reply_by")
  followUpAt       DateTime?      @map("follow_up_at")
  reminderSentAt   DateTime?      @map("reminder_sent_at")

  @@map("waiting_details")
}

/// TBL-011 constraints - 期限・場所・権限等（責任に従属、responsibilities.typeには含めない）[推論]
model Constraint {
  id               String         @id @default(uuid())
  responsibilityId String         @map("responsibility_id")
  responsibility   Responsibility @relation(fields: [responsibilityId], references: [id], onDelete: Cascade)
  /// DEADLINE/LOCATION/PERMISSION/RESOURCE等 [推論]
  constraintType   String         @map("constraint_type")
  value            Json
  note             String?
  createdAt        DateTime       @default(now()) @map("created_at")

  @@map("constraints")
}

/// TBL-012 responsibility_relations - 責任間の有向関係
model ResponsibilityRelation {
  id            String         @id @default(uuid())
  fromId        String         @map("from_id")
  from          Responsibility @relation("RelationFrom", fields: [fromId], references: [id])
  toId          String         @map("to_id")
  to            Responsibility @relation("RelationTo", fields: [toId], references: [id])
  /// PRECEDES/BLOCKS/DEPENDS_ON等
  relationType  String         @map("relation_type")
  /// CANDIDATE/CONFIRMED/REJECTED
  status        String
  confidence    Decimal?       @db.Decimal(4, 3)
  sourceKind    String?        @map("source_kind")
  sourceRef     String?        @map("source_ref")
  confirmedById String?        @map("confirmed_by")
  confirmedAt   DateTime?      @map("confirmed_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  deletedAt     DateTime?      @map("deleted_at")

  @@map("responsibility_relations")
}

/// TBL-020 recurrence_rules（FN-REC-01対応）
model RecurrenceRule {
  id               String         @id @default(uuid())
  responsibilityId String         @unique @map("responsibility_id")
  responsibility   Responsibility @relation(fields: [responsibilityId], references: [id], onDelete: Cascade)
  /// DAILY/WEEKLY/MONTHLY等
  frequency        String
  interval         Int
  weekdays         Json?
  exceptions       Json?
  pausedUntil      DateTime?      @map("paused_until")
  /// CARRY/DROP/RENOTIFY
  carryoverPolicy  String         @map("carryover_policy")
  lastGeneratedAt  DateTime?      @map("last_generated_at")
  version          Int            @default(0)

  @@map("recurrence_rules")
}

/// TBL-027 cycles - 週次サイクル(2026-08-22新設・カルキョンさんの依頼で参考記事
/// [note.com/bingo10/n/n6ae59c33be8b「個人のタスク管理こそLinear」]の「Cycles」機能を
/// 参考に設計。設計書に既存記載が無いため新規TBDとして扱う)。
/// 月曜開始・日曜終了の固定週区切りで自動生成され、未完了の責任は次サイクルへ
/// 自動持ち越しされる("罪悪感を感じる間もなくシステムが繋いでくれる"という
/// 記事内の知見を、dedupeの効いた自動繰越ジョブとして実装)。
model Cycle {
  id          String    @id @default(uuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  startAt     DateTime  @map("start_at")
  endAt       DateTime  @map("end_at")
  /// ACTIVE/CLOSED [推論]
  status      String    @default("ACTIVE")
  createdAt   DateTime  @default(now()) @map("created_at")

  items CycleItem[]

  @@unique([workspaceId, startAt])
  @@map("cycles")
}

/// TBL-028 cycle_items - サイクルへコミットした責任(2026-08-22新設)。
/// carriedFromCycleIdは、直前のサイクルで未完了だったために自動持ち越しされた
/// 場合の出典サイクルを指す(UIで「先週から持ち越し」バッジを出すために使う)。
model CycleItem {
  id                 String         @id @default(uuid())
  cycleId            String         @map("cycle_id")
  cycle              Cycle          @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  responsibilityId   String         @map("responsibility_id")
  responsibility     Responsibility @relation(fields: [responsibilityId], references: [id], onDelete: Cascade)
  carriedFromCycleId String?        @map("carried_from_cycle_id")
  addedAt            DateTime       @default(now()) @map("added_at")

  @@unique([cycleId, responsibilityId])
  @@map("cycle_items")
}

