/// TBL-016 pem_observations [推論・DB設計書4.5節に準拠]
model PemObservation {
  id               String    @id @default(uuid())
  userId           String    @map("user_id")
  user             User      @relation(fields: [userId], references: [id])
  observationType  String    @map("observation_type")
  payload          Json
  validUntil       DateTime? @map("valid_until")
  occurredAt       DateTime  @default(now()) @map("occurred_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  /// [2026-08-24訂正・Phase 0C-2] v4.0 16.3節により論理削除はinsert-onlyの
  /// PemEvidenceDeletionEvent(evidenceDeletion.ts参照)へ移行した。この列自体は
  /// 過去データとの後方互換のため残すが、以後のコードはこの列を読み書きしない
  /// (削除判定はgetDeletedEvidenceIds()を正とする)。
  deletedAt        DateTime? @map("deleted_at")
  /// 新設(2026-08-23・FN-PEM-02対応): observationType="TRANSITION"(生イベント取り込み)の
  /// 冪等性キー。機能別詳細設計書v1.1 13章「PEMObserverはResponsibilityTransitionedを
  /// 購読し、eventIdで重複排除する」に対応。EventLog.idを保持し、@uniqueによる
  /// DB制約で二重取り込みを防ぐ(worker/relay.tsと同じP2002依拠の冪等パターン)。
  /// observationType="OBSERVATION"(集計結果)の行はnull(集計は日次で再計算されるため
  /// 単一イベントに紐付かない)。
  sourceEventLogId String?   @unique @map("source_event_log_id")

  evidenceLinks PemEvidenceLink[]

  @@map("pem_observations")
}

/// TBL-017 pem_hypotheses [推論・DB設計書4.5節に準拠]
/// TBL(PEM Phase 0S) pem_consent_events - PEM同意Ledger(insert-only) [出典: PEMサブシステム統合正本仕様書v4.0 16.1節]
model PemConsentEvent {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  user          User     @relation(fields: [userId], references: [id])
  /// [2026-08-25追加・Completion Gate 1] tenant境界(v4.0 16.1節が要求する
  /// workspaceId)。既存行はworkspace_membersからbackfillした(MVPは1ユーザー1
  /// Workspace前提のため、複数所属時は最初に参加したWorkspaceを採用)。
  workspaceId   String   @map("workspace_id")
  /// PEM_DATA_COLLECTION/PEM_AI_PROCESSING/PEM_PLANNING_APPLICATION/PEM_EXPERIMENT/SENSITIVE_SELF_REPORT
  consentType   String   @map("consent_type")
  /// GRANTED/WITHDRAWN
  action        String
  policyVersion String   @map("policy_version")
  /// [2026-08-25追加] v4.0 16.1節が要求するConsent scope。正式な構造の記載が原本に
  /// 無いため、列のみ用意し現状は常にnull(想像で構造を作らない)。
  scope         Json?
  /// ONBOARDING/SETTINGS
  source        String
  occurredAt    DateTime @default(now()) @map("occurred_at")

  @@index([userId, consentType])
  @@index([workspaceId])
  @@map("pem_consent_events")
}

/// TBL(PEM Completion Gate 1) pem_metric_consent_events - metric単位OFFのLedger
/// [出典: PEMサブシステム統合正本仕様書v4.0 16.2節「metric OFF」]
/// insert-only。GRANTED=そのmetricの利用を許可、WITHDRAWN=そのmetricだけを無効化。
/// イベントが1件も無いmetricは、metricDefinitionRegistry.tsの登録有無
/// (isMetricEnabledByDefault)がデフォルト値になる。
model PemMetricConsentEvent {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  user          User     @relation(fields: [userId], references: [id])
  workspaceId   String   @map("workspace_id")
  metricKey     String   @map("metric_key")
  /// GRANTED/WITHDRAWN
  action        String
  policyVersion String   @map("policy_version")
  /// ONBOARDING/SETTINGS
  source        String
  occurredAt    DateTime @default(now()) @map("occurred_at")

  @@index([userId, metricKey])
  @@map("pem_metric_consent_events")
}

/// TBL(PEM Phase 0A) responsibility_execution_events - Execution Event Ledger本体 [出典: PEMサブシステム統合正本仕様書v4.0 5章]
/// TBL(PEM Phase 0A) responsibility_execution_events - Execution Event Ledger本体
/// [出典: PEMサブシステム統合正本仕様書v4.0 5章]
/// [2026-08-24改訂・Phase 0A是正2] 5.3節Eventスキーマの必須列・複合unique・tenant複合FKを
/// 追加した。ただし列を追加しただけで、実際に値を計算・伝播するアプリケーションロジックが
/// 伴わない項目がある(clockOffset*・sourceDeviceId・clientEventId等。本ファイル冒頭の
/// パッチスクリプトdocstring参照)。列の存在と機能の完成度は別である。
model ResponsibilityExecutionEvent {
  id                           String                         @id @default(uuid())
  workspaceId                  String                         @map("workspace_id")
  subjectUserId                String                         @map("subject_user_id")
  actorType                    String                         @map("actor_type")
  actorUserId                  String?                        @map("actor_user_id")
  /// [新設] SYSTEM/WORKER由来イベントを生成した場合のサービス識別子。
  /// 現状USER操作のみのため常にnull(v4.0 4章)。
  actorServiceId               String?                        @map("actor_service_id")
  /// [新設] AI Agent由来イベントを生成した場合のAgent識別子。現状常にnull。
  actorAgentId                 String?                        @map("actor_agent_id")
  /// [新設] 代理操作を行った場合、代理権限を与えた本人のuserId。現状代理操作機能が
  /// 無いため常にnull。
  delegatedByUserId            String?                        @map("delegated_by_user_id")
  /// [新設] 認証・認可判断の追跡ID(v4.0 4章)。PemAuthorizationContext.authenticationContextId
  /// をそのまま保存する。[既知の簡略化] 現状のtransitions/route.tsは真の認証コンテキストID
  /// ではなくuserIdを暫定的に渡しているため、値の質はその制約を引き継ぐ。
  authenticationContextId      String?                        @map("authentication_context_id")
  /// [新設] API要求単位の追跡ID(v4.0 5.3節)。x-request-idヘッダがあれば優先、
  /// 無ければ要求ごとにrandomUUID()で発行する(transitions/route.ts参照)。
  requestId                    String                         @map("request_id")
  responsibilityId             String                         @map("responsibility_id")
  /// [2026-08-24改訂] 単一列(responsibilityId)参照から、(responsibilityId, workspaceId)の
  /// 複合参照へ変更した。EventのworkspaceIdとResponsibilityのworkspaceIdが常に一致する
  /// ことをDBレベルで保証する(v4.0 4.1節「tenantを跨ぐFK参照…を禁止する」)。
  responsibility               Responsibility                 @relation(fields: [responsibilityId, workspaceId], references: [id, workspaceId])
  /// START/RESUME/INTERRUPT/DEFER/SWITCH_OUT/COMPLETE/REOPEN/RESPONSIBILITY_ABANDON/AUTO_PAUSE_CONFIRMED
  eventType                    String                         @map("event_type")
  fromState                    String                         @map("from_state")
  toState                      String                         @map("to_state")
  responsibilityVersionBefore  Int                            @map("responsibility_version_before")
  responsibilityVersionAfter   Int                            @map("responsibility_version_after")
  responsibilitySequence       Int                            @map("responsibility_sequence")
  /// [新設] 欠番・commit順不一致を許容する参考識別子(v4.0 5.3節)。意味的順序・配送順・
  /// commit順の保証には使わない(responsibilitySequenceが意味的順序の正)。DB側の
  /// シーケンスで採番する。
  globalSequence               BigInt                         @unique(map: "ree_global_sequence_uq") @default(autoincrement()) @map("global_sequence")
  source                       String
  /// [新設] 端末識別子。オフライン同期・複数端末競合検知は未実装のため常にnull。
  sourceDeviceId               String?                        @map("source_device_id")
  /// [新設] 端末側の冪等キー(オフライン再送検知用)。未実装のため常にnull。
  clientEventId                String?                        @map("client_event_id")
  /// [新設] 端末側の順序番号。未実装のため常にnull。
  clientSequence               BigInt?                        @map("client_sequence")
  /// [改訂] v4.0 6.1節「SYSTEM/WORKER由来イベントではclientOccurredAtをnullとし、
  /// サーバー時刻を採用する」に合わせ必須→任意化した(現状はUSER操作のみのため
  /// 実質常に値が入るが、将来SYSTEM/WORKER経路が実装された際に備える)。
  clientOccurredAt             DateTime?                      @map("client_occurred_at")
  serverRecordedAt             DateTime                       @default(now()) @map("server_recorded_at")
  effectiveOccurredAt          DateTime                       @map("effective_occurred_at")
  occurredAtQuality            String                         @map("occurred_at_quality")
  /// [新設] 既知のclock offset(秒)。オフライン同期のclock補正は未実装のため常にnull。
  clockOffsetSeconds           Int?                           @map("clock_offset_seconds")
  clockOffsetMeasuredAt        DateTime?                      @map("clock_offset_measured_at")
  idempotencyKey               String                         @map("idempotency_key")
  /// [新設] 同一idempotencyKeyでpayloadが異なる場合の409判定に使う要求本文のhash
  /// (v4.0 5.5節)。transitions/route.tsがsha256で計算して渡す。
  requestPayloadHash           String                         @map("request_payload_hash")
  schemaVersion                String                         @map("schema_version")
  correlationId                String?                        @map("correlation_id")
  causationId                  String?                        @map("causation_id")
  /// [改訂] 従来Json?(任意)だったが、v4.0 5.3節はJson(必須)を要求する。
  /// 既存null行はマイグレーションで{}へbackfillし、NOT NULL化した。
  metadata                     Json                           @default("{}")
  /// [新設] 行の物理作成時刻。従来欠落していた。
  createdAt                    DateTime                       @default(now()) @map("created_at")
  /// [2026-08-25新設・Completion Gate 2.1] このEventを取り消したCorrection(REVOKE等)。
  /// 通常1件だが、将来の再訂正(訂正の訂正)に備え配列とする。
  correctionsOfThisEvent       ResponsibilityLifecycleEvent[] @relation("LifecycleCorrectionOfEvent")
  /// [2026-08-25新設・Completion Gate 2.1] このEvent自身が、あるCorrectionの結果として
  /// 生成された場合の逆参照(例: COMPLETE取消により生成されたREOPEN Event)。
  resultingFromLifecycleEvents ResponsibilityLifecycleEvent[] @relation("LifecycleResultingEvent")
  /// [2026-08-26新設・Undo Receipt] このEventを参照するBulkCompleteReceipt。
  bulkCompleteReceipts         BulkCompleteReceipt[]

  /// [改訂] tenantId(workspaceId)を含む複合uniqueへ変更(v4.0 5.3節、批評4.5対応)。
  /// [2026-08-24再修正] 3つの@@unique全てに明示的なmap名を付与した。理由:
  /// Prismaの自動生成制約名は「テーブル名+全フィールド名+_key」だが、本モデルは
  /// workspaceId/subjectUserIdで始まる長いフィールド名の組み合わせが複数あり、
  /// PostgreSQLの識別子長制限(63バイト)で切り詰められた結果、idempotencyKey用と
  /// clientEventId用の自動生成名が衝突しPrisma検証エラー(P1012)になった
  /// (実サーバーでの実行結果から判明)。migration.sqlで実際に使っている
  /// 短い制約名と一致させる。
  @@unique([workspaceId, responsibilityId, responsibilitySequence], map: "ree_workspace_responsibility_sequence_uq")
  @@unique([workspaceId, subjectUserId, idempotencyKey], map: "ree_idempotency_uq")
  /// [新設] v4.0 5.3節が要求する複合unique(clientEventIdは任意列のため、
  /// 複数行がnullの場合はPostgreSQLの既定動作によりunique違反にならない)。
  @@unique([workspaceId, subjectUserId, clientEventId], map: "ree_workspace_subject_client_event_uq")
  /// [2026-08-25新設・Completion Gate 2.1] ResponsibilityLifecycleEventが
  /// correction_of_event_id/resulting_event_idで本Eventを参照する際、tenant(workspaceId)を
  /// 含む複合FKにするための参照先(v4.0 4.1節「DB制約とアプリケーション認可による二重化」)。
  /// idは既にPKで単独unique だが、複合FKの参照先には対象列の複合uniqueが必要。
  @@unique([id, workspaceId], map: "ree_id_workspace_uq")
  @@index([responsibilityId])
  @@map("responsibility_execution_events")
}

/// [2026-08-25新設・Completion Gate 2.1]
/// 出典: ISMAY_PEMサブシステム_統合正本仕様書_v4_0 8.1節「Correction」
///  「元Evidenceを更新せず、Correction Eventを追記する」、
///  ISMAY_PEM_v3_3_1整合性修正_用語コード定義書_v1_0 8章(Correction Type)。
///
/// ResponsibilityExecutionEvent(Execution Ledger)はimmutableな正本Eventのみを保持し、
/// 「過去のEventを訂正する」という行為自体はここへ別レコードとして追記する
/// (Execution Ledgerの行を直接UPDATEしない。insert-only)。
///
/// kind=CORRECTIONの場合: 一括完了の取消(Undo)のように、確定していた完了を取り消す
/// 操作を記録する。correctionOfEventIdは取消対象の元Event(通常はCOMPLETE Event)、
/// resultingEventIdはその結果として新たに記録されたExecution Event(通常はREOPEN Event)
/// を指す。Lifecycle Eventが記録されるのは、訂正対象の元Execution Eventを実際に
/// 特定できた場合(=Execution Ledger対象型かつCOMPLETE Eventが見つかった場合)のみ。
///
/// kind=RECURRENCE_RESETの場合: 定期責任のサイクルリセット(recurrence.ts
/// resetForNextCycle)。SYSTEM(Worker)による自動処理であり、Execution LedgerのREOPENは
/// allowedActors=["USER"]のため使えないが、状態が変わった事実そのものはinsert-onlyで
/// 記録する必要があるため、Correctionとは別kindとしてここに記録する。
model ResponsibilityLifecycleEvent {
  id               String         @id @default(uuid())
  workspaceId      String         @map("workspace_id")
  subjectUserId    String         @map("subject_user_id")
  responsibilityId String         @map("responsibility_id")
  /// [tenant境界の二重防御] ResponsibilityExecutionEventと同じ複合FK参照方式。
  responsibility   Responsibility @relation(fields: [responsibilityId, workspaceId], references: [id, workspaceId])

  /// CORRECTION / RECURRENCE_RESET(coreTypes.ts LIFECYCLE_EVENT_KINDS)。
  kind                String                        @map("kind")
  /// REPLACE / REVOKE / SPLIT / MERGE_REQUEST(coreTypes.ts CORRECTION_TYPES)。
  /// kind=RECURRENCE_RESETの場合は常にnull。
  correctionType      String?                       @map("correction_type")
  correctionOfEventId String?                       @map("correction_of_event_id")
  /// [tenant境界二重化] workspaceIdを含む複合FK(参照先はResponsibilityExecutionEventの
  /// 複合unique[id, workspaceId])。
  correctionOfEvent   ResponsibilityExecutionEvent? @relation("LifecycleCorrectionOfEvent", fields: [correctionOfEventId, workspaceId], references: [id, workspaceId])
  resultingEventId    String?                       @map("resulting_event_id")
  resultingEvent      ResponsibilityExecutionEvent? @relation("LifecycleResultingEvent", fields: [resultingEventId, workspaceId], references: [id, workspaceId])

  fromState String @map("from_state")
  toState   String @map("to_state")

  reason      String?
  actorType   String  @map("actor_type")
  actorUserId String? @map("actor_user_id")

  /// 同一の訂正対象への重複記録を防ぐ(bulkCompleteUndoDecision.ts参照)。
  idempotencyKey     String @map("idempotency_key")
  /// 同一idempotencyKeyでpayloadが異なる場合の409(IDEMPOTENCY_KEY_REUSED)判定に使う。
  requestPayloadHash String @map("request_payload_hash")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([workspaceId, subjectUserId, idempotencyKey], map: "rle_idempotency_uq")
  @@index([responsibilityId])
  @@index([correctionOfEventId, workspaceId])
  @@map("responsibility_lifecycle_events")
}

/// [2026-08-26新設・外部監査で指摘された根本問題の是正]
/// これまでのCompletion Gate 2.1実装は、Bulk Complete APIが返す
/// snapshot(status/completedAt/completeEventId)をクライアントが保持し、
/// Undo実行時にそのままサーバーへ送り返す「ステートレスUndo」だった。
/// クライアントは(悪意の有無に関わらず)snapshotを自由に書き換えられるため、
/// 「完了操作の遷移元として有効な別のstatus」への改ざんによる誤復元や、
/// PEM Execution Ledger(同意任意で記録されないことがある)の有無に冪等性が
/// 依存してしまう問題が繰り返し発生した(外部監査で指摘)。
///
/// 是正: Bulk Complete実行時に、復元先の真の情報をサーバー側insert-onlyで
/// 保存する「Undo Receipt」を導入する。クライアントはreceiptIdだけを持ち回り、
/// 実際のfromStatus/toStatus/completeEventIdは常にこのテーブルから読む
/// (クライアントが送ってくる値を一切信用しない)。
model BulkCompleteReceipt {
  id                         String                        @id @default(uuid())
  workspaceId                String                        @map("workspace_id")
  subjectUserId              String                        @map("subject_user_id")
  responsibilityId           String                        @map("responsibility_id")
  /// [tenant境界の二重防御] 既存パターンと同じ複合FK参照方式。
  responsibility             Responsibility                @relation(fields: [responsibilityId, workspaceId], references: [id, workspaceId])
  /// バッチ全体で共有するid(bulkComplete呼び出し単位)。監査・調査用。
  operationId                String                        @map("operation_id")
  /// 完了前の真の状態(サーバーがBulk Complete実行時に記録。クライアントからは
  /// 一切受け取らない)。
  fromStatus                 String                        @map("from_status")
  /// 完了操作が実際に到達したstatus。
  toStatus                   String                        @map("to_status")
  /// [2026-08-26新設・外部監査P0-1是正]
  /// この完了操作の直後にResponsibilityが持っていたversion。「このレシートが
  /// 今のResponsibilityにとって最新の完了サイクルに対応しているか」の世代確認に
  /// 使う。単純に`t.status === receipt.toStatus`だけで「現在完了状態か」を
  /// 判定すると、古い(既にUndo済みだが再度同じtoStatusへ完了した)レシートが
  /// 誤って「現在も有効」と判定され、無関係な別の完了サイクルを取り消して
  /// しまう恐れがあった(外部監査で指摘)。versionは完了・Undoのたびに必ず
  /// +1されるため、これと一致するかどうかが「まさにこの完了操作が生んだ状態か」
  /// を一意に判定できる。
  responsibilityVersionAfter Int                           @map("responsibility_version_after")
  /// このBulk Complete操作でExecution Ledgerへ実際に記録されたCOMPLETE Eventのid
  /// (Execution Ledger対象外型、またはPEM同意未取得等で記録できなかった場合はnull)。
  completeEventId            String?                       @map("complete_event_id")
  completeEvent              ResponsibilityExecutionEvent? @relation(fields: [completeEventId, workspaceId], references: [id, workspaceId])
  createdAt                  DateTime                      @default(now()) @map("created_at")

  consumption BulkCompleteUndoConsumption?

  /// [2026-08-26新設・外部監査「DB整合性上の不足」是正] BulkCompleteUndoConsumption
  /// からの複合FK参照先。tenant/actor情報がDB制約レベルでも一致することを保証する
  /// (アプリケーションコードのWHERE句だけに頼らない)。
  @@unique([id, workspaceId, subjectUserId], map: "bcr_id_workspace_subject_uq")
  @@index([responsibilityId])
  @@index([workspaceId, subjectUserId])
  @@map("bulk_complete_receipts")
}

/// [2026-08-26新設] Undo実行の冪等記録。receiptId単位で1回だけ許可する
/// (insert-only、receiptIdへunique制約)。PEM Execution Ledgerの有無に関わらず
/// 全ての型・全ての同意状態で一様に機能する冪等性の正本。
model BulkCompleteUndoConsumption {
  id                 String              @id @default(uuid())
  /// [receiptId単独のunique制約] 「1レシートにつき冪等記録は1件だけ」という
  /// 唯一性そのものを保証する(冪等性の核心)。下の複合unique(3列)とは別目的の
  /// 制約であり、両方が同時に必要。
  receiptId          String              @unique @map("receipt_id")
  workspaceId        String              @map("workspace_id")
  subjectUserId      String              @map("subject_user_id")
  /// [2026-08-26改訂・外部監査「DB整合性上の不足」是正、および前回のPrisma
  /// バリデーションエラー(P1012)の是正]
  /// 従来はreceiptId単独でのFKだったため、DB制約だけではこのConsumptionの
  /// workspaceId/subjectUserIdが参照先Receiptのそれと一致することを保証
  /// できていなかった。BulkCompleteReceipt側に追加した複合unique
  /// (id, workspaceId, subjectUserId)を参照する複合FKへ変更し、tenant/actorの
  /// 不一致をDB制約レベルで拒否する。
  /// [P1012是正] Prismaは一対一リレーションの参照元(このモデル)に、@relationの
  /// fieldsと完全一致するunique制約を要求する。receiptId単独のunique(上記)
  /// だけでは(receiptId, workspaceId, subjectUserId)という3列の組み合わせを
  /// カバーしないため、Prismaの検証(P1012)に失敗していた。このモデル自身にも
  /// 同じ3列の複合uniqueを追加する(receiptId単独のuniqueとは目的が異なるため
  /// 両立させる。実データとしては両方とも常に満たされる)。
  receipt            BulkCompleteReceipt @relation(fields: [receiptId, workspaceId, subjectUserId], references: [id, workspaceId, subjectUserId])
  requestPayloadHash String              @map("request_payload_hash")
  createdAt          DateTime            @default(now()) @map("created_at")

  @@unique([receiptId, workspaceId, subjectUserId], map: "bcuc_receipt_workspace_subject_uq")
  @@map("bulk_complete_undo_consumptions")
}

model PemHypothesis {
  id                String    @id @default(uuid())
  userId            String    @map("user_id")
  user              User      @relation(fields: [userId], references: [id])
  statement         String
  sampleSize        Int       @map("sample_size")
  windowFrom        DateTime  @map("window_from")
  windowTo          DateTime  @map("window_to")
  confidence        Decimal   @db.Decimal(4, 3)
  validUntil        DateTime? @map("valid_until")
  /// UNREVIEWED(未評決)/AGREED(合っている)/DISAGREED(違う)/PARTIALLY_AGREED(部分的に合っている)
  /// [出典: PEMサブシステム統合正本仕様書v4.0 12.2節]
  /// [2026-08-24訂正・Phase 0C-3] 従来はCONFIRMED/REJECTED/TEMPORARY/PENDINGという
  /// 別語彙だった(PHASE_0G_COMPATIBILITY_LEDGER.md参照)。TEMPORARY(今だけ一時的)は
  /// 評決ではなくTemporary State側の概念(Phase 1で新設予定、未着手)のため、新語彙には
  /// 対応する値が無い。既存TEMPORARY行はUNREVIEWEDへ移行し、元の値はlegacyUserVerdict
  /// (下記)へ退避した。「今後使わない」は引き続き本レコードのdeletedAt(forget操作、
  /// このモデルに限りv4.0 16.3節のinsert-only化対象外。衝突台帳未フラグ)として表現する。
  userVerdict       String    @default("UNREVIEWED") @map("user_verdict")
  /// [新設・Phase 0C-3] マイグレーション前のuserVerdict値の退避列(CONFIRMED/REJECTED/
  /// TEMPORARY/PENDING)。特にTEMPORARYだった仮説をPhase 1のTemporary State実装時に
  /// 洗い出せるようにするため削除しない。新規作成される行では常にnull。
  legacyUserVerdict String?   @map("legacy_user_verdict")
  /// 新設(2026-08-23・FN-PEM-03対応): AI-07自動生成時のみ設定する集計指標キー
  /// (例: "DEFER_RATE_BY_ESTIMATE"、lib/pem.tsのOBSERVATION.payload.metricと対応)。
  /// 「本人がREJECTした仮説は同じ根拠だけで再提案しない」(機能別詳細設計書v1.1 13章)を
  /// 満たすため、再生成前に同一metricの既存仮説を確認する用途に使う。初回対話由来(null)は対象外。
  sourceMetric      String?   @map("source_metric")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  evidenceLinks PemEvidenceLink[]

  @@map("pem_hypotheses")
}

/// TBL-018 pem_evidence_links - PEMと証拠参照（責任に従属）[推論]
model PemEvidenceLink {
  id               String          @id @default(uuid())
  pemObservationId String?         @map("pem_observation_id")
  pemObservation   PemObservation? @relation(fields: [pemObservationId], references: [id])
  pemHypothesisId  String?         @map("pem_hypothesis_id")
  pemHypothesis    PemHypothesis?  @relation(fields: [pemHypothesisId], references: [id])
  evidenceId       String          @map("evidence_id")
  evidence         Evidence        @relation(fields: [evidenceId], references: [id])
  createdAt        DateTime        @default(now()) @map("created_at")

  @@map("pem_evidence_links")
}

/// [2026-08-24改訂・Phase 0E] FN-PEM-01 初回対話のConversationState永続化。
/// 出典: PEMサブシステム統合正本仕様書v4.0 11章、
/// PHASE_0G_COMPATIBILITY_LEDGER.md「PemOnboardingConversation.userId @unique」行。
/// 従来は1ユーザー1件固定(userIdがunique)だったが、v4.0はINITIAL/RECALIBRATION/
/// MAJOR_CHANGEを複数履歴として許可するため、unique制約を外し複数行を許容する。
/// [スコープ] 本改訂はデータモデルのみ。RECALIBRATION/MAJOR_CHANGEを実際にいつ・
/// どうトリガーするかの業務ロジックは未実装(v4.0 11章の該当詳細が未確認のため、
/// 想像で実装しない判断)。現状は新規対話を常にconversationKind="INITIAL"で作成する
/// (lib/ai/pemOnboarding.tsのfindOrCreateCurrentConversation参照)。
model PemOnboardingConversation {
  id                 String    @id @default(uuid())
  userId             String    @map("user_id")
  user               User      @relation(fields: [userId], references: [id])
  /// INITIAL/RECALIBRATION/MAJOR_CHANGE(v4.0 11章)。既存データはbackfillでINITIALとする。
  conversationKind   String    @default("INITIAL") @map("conversation_kind")
  /// ROLE/CURRENT_LOAD/FIXED_CONSTRAINTS/EXECUTION_CONTEXT/VALUES/REVIEW/DONE [推論]
  state              String    @default("ROLE")
  /// {role: "assistant"|"user", content: string, at: string}[] の対話履歴全体
  messages           Json      @default("[]")
  /// 本人未確認のFACT候補({statement, evidenceMessageIndex}[])。REVIEW段階で提示し、
  /// 確認されたものだけpem_observations(observationType="FACT")へ昇格させる。
  proposedFacts      Json      @default("[]") @map("proposed_facts")
  proposedHypotheses Json      @default("[]") @map("proposed_hypotheses")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  completedAt        DateTime? @map("completed_at")

  @@index([userId, createdAt])
  @@map("pem_onboarding_conversations")
}

/// 新設(2026-08-23・FN-PEM-03対応): 週次レビュー(AI-08)のキャッシュ。
/// API-PEM-03(GET /reviews/weekly)は「直近の完了済み週のレビューが無ければその場で
/// AI生成し、あれば再利用する」設計のため、週単位で1行(userId, weekStart)に保存する。
/// TBL番号未採番([推論]。DB設計書のTBL-016〜018には無いが、AI-08「原データ変更不可」を
/// 満たしつつ毎回AI再呼び出しするとコスト目標(月額¥300〜500)に反するため新設)。
model PemWeeklyReview {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id])
  /// 週境界はlib/cycle.tsのCycleと同じ月曜0:00〜翌月曜0:00(排他的)。
  weekStart   DateTime @map("week_start")
  weekEnd     DateTime @map("week_end")
  /// {fulfilledCount, stalledCount, estimateErrorPercent, strengthStatement,
  ///  experimentSuggestion, generatedByAi}
  summaryJson Json     @map("summary_json")
  generatedAt DateTime @default(now()) @map("generated_at")

  @@unique([userId, weekStart])
  @@map("pem_weekly_reviews")
}

/// TBL(PEM Phase 0C) pem_evidence_deletion_events - Evidence削除Ledger(insert-only)
/// [出典: PEMサブシステム統合正本仕様書v4.0 16.3節]
model PemEvidenceDeletionEvent {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  user         User     @relation(fields: [userId], references: [id])
  /// 現時点はPEM_OBSERVATIONのみ(PHASE_0G_COMPATIBILITY_LEDGER.md参照)。
  targetType   String   @map("target_type")
  targetId     String   @map("target_id")
  /// EXCLUDED_FROM_USE/REDACTED/ANONYMIZED/CRYPTOGRAPHICALLY_ERASED/
  /// PHYSICALLY_DELETED/LEGALLY_RETAINED(coreTypes.ts EvidenceDeletionMode)
  deletionMode String   @map("deletion_mode")
  reason       String?
  occurredAt   DateTime @default(now()) @map("occurred_at")

  @@index([userId, targetType, targetId])
  @@map("pem_evidence_deletion_events")
}

/// TBL(PEM Phase 0B-2) execution_session_identities - 論理Session識別子
/// [出典: PEMサブシステム統合正本仕様書v4.0 7.2節]
/// 論理Session1つにつき1行。startEventId(START/RESUMEイベント)で一意に定まる。
model ExecutionSessionIdentity {
  id               String         @id @default(uuid())
  workspaceId      String         @map("workspace_id")
  subjectUserId    String         @map("subject_user_id")
  responsibilityId String         @map("responsibility_id")
  /// [v4.0 4.1節] tenant跨ぎ参照をDBで禁止する複合FK(ResponsibilityExecutionEvent
  /// と同じパターン。Phase 0A是正2参照)。
  responsibility   Responsibility @relation(fields: [responsibilityId, workspaceId], references: [id, workspaceId])
  /// このSessionを開始したResponsibilityExecutionEvent.id(START/RESUME)。
  startEventId     String         @map("start_event_id")
  createdAt        DateTime       @default(now()) @map("created_at")

  revisions ExecutionSessionRevision[]

  @@unique([workspaceId, startEventId], map: "esi_workspace_start_event_uq")
  @@index([responsibilityId])
  @@map("execution_session_identities")
}

/// TBL(PEM Phase 0B-2) execution_session_revisions - Session内容のinsert-only履歴
/// [出典: PEMサブシステム統合正本仕様書v4.0 7.2節]
/// insert-only。内容が変わった場合のみ新Revisionを追記し、旧行はUPDATEしない
/// (v4.0「旧版をSUPERSEDEDへ直接更新せず」)。「現在版」はsessionIdentityId内で
/// 最大のrevision番号を持つ行として投影で決定する(SUPERSEDEDは独立したstatus値
/// として保存しない)。
model ExecutionSessionRevision {
  id                     String                   @id @default(uuid())
  sessionIdentityId      String                   @map("session_identity_id")
  sessionIdentity        ExecutionSessionIdentity @relation(fields: [sessionIdentityId], references: [id])
  revision               Int
  /// fold algorithm(sessionProjection.ts computeExecutionSessions)自体の版。
  derivationVersion      String                   @map("derivation_version")
  /// OPEN/CLOSED_CONFIRMED/CLOSED_UNCONFIRMED(v4.0 7.1節・7.3節。値集合は原本に
  /// 明記が無いため本文の記述から導出。sessionPersistence.ts参照)。
  status                 String
  startedAt              DateTime                 @map("started_at")
  endedAt                DateTime?                @map("ended_at")
  /// INTERRUPT/DEFER/SWITCH_OUT/COMPLETE/AUTO_PAUSE_CONFIRMED/TIMEOUT。
  endReason              String?                  @map("end_reason")
  rawElapsedSeconds      Int                      @map("raw_elapsed_seconds")
  /// Activity Segmentによる補正後の実作業秒数(v4.0 7.4節、未実装のため常にnull)。
  correctedActiveSeconds Int?                     @map("corrected_active_seconds")
  /// [既知の簡略化] Activity Evidence Ledger未実装のため常に"EXECUTION_LEDGER_ONLY"。
  measurementMode        String                   @map("measurement_mode")
  measurementQuality     String                   @map("measurement_quality")
  qualityReasonCodes     Json                     @default("[]") @map("quality_reason_codes")
  timeZoneId             String?                  @map("time_zone_id")
  utcOffsetMinutes       Int?                     @map("utc_offset_minutes")
  supersedesRevisionId   String?                  @map("supersedes_revision_id")
  createdAt              DateTime                 @default(now()) @map("created_at")

  @@unique([sessionIdentityId, revision], map: "esr_identity_revision_uq")
  @@map("execution_session_revisions")
}

/// TBL(PEM Phase 0C-1-2) reason_prompts - Reason Prompt識別子
/// [出典: PEMサブシステム統合正本仕様書v4.0 8.2節]
/// 「同一trigger Eventに対するPromptは1件とする」。1 trigger Event = 1 Prompt。
model ReasonPrompt {
  id             String   @id @default(uuid())
  workspaceId    String   @map("workspace_id")
  subjectUserId  String   @map("subject_user_id")
  /// このPromptを発生させたResponsibilityExecutionEvent.id
  /// (INTERRUPT/DEFER/REOPEN/RESPONSIBILITY_ABANDON等、requiresReasonPrompt=trueのEvent)。
  /// IDは常に同一トランザクション内で自分が作成した行のものであり(ユーザー入力から
  /// 直接受け取らない)、tenant跨ぎ参照のリスクが無いため単純な単一列FKとする
  /// (ResponsibilityExecutionEvent.idはグローバルに一意なUUID)。
  triggerEventId String   @unique(map: "reason_prompts_trigger_event_id_uq") @map("trigger_event_id")
  createdAt      DateTime @default(now()) @map("created_at")

  stateEvents ReasonPromptStateEvent[]
  answers     ExecutionReasonAnswer[]

  @@map("reason_prompts")
}

/// TBL(PEM Phase 0C-1-2) reason_prompt_state_events - Prompt状態のinsert-only履歴
/// [出典: PEMサブシステム統合正本仕様書v4.0 8.2節]
/// TRIGGERED/DELIVERED/DISPLAYED/ANSWERED/SKIPPED/EXPIRED/DELIVERY_FAILED。
/// 「現在状態と履歴を分離し、矛盾する同時状態を許さない」→現在状態は最新行からの
/// 投影で決定する(Phase 0S Consentと同じinsert-only+投影パターン)。
/// [既知の簡略化] 現行UIはreason入力を遷移リクエストと同時に送るため、
/// DELIVERED/DISPLAYED/EXPIRED/DELIVERY_FAILEDへは到達しない(TRIGGERED直後に
/// ANSWEREDまたはSKIPPEDのみ記録する。reasonLedger.ts参照)。
model ReasonPromptStateEvent {
  id         String       @id @default(uuid())
  promptId   String       @map("prompt_id")
  prompt     ReasonPrompt @relation(fields: [promptId], references: [id])
  state      String
  occurredAt DateTime     @default(now()) @map("occurred_at")

  @@index([promptId])
  @@map("reason_prompt_state_events")
}

/// TBL(PEM Phase 0C-1-2) execution_reason_answers - Execution Reasonの回答
/// [出典: PEMサブシステム統合正本仕様書v4.0 8.3節]
/// insert-only。「自由記述からAIが分類したReasonと本人選択Reasonを分離する」ため、
/// reasonCode(本人選択)とaiClassifiedReasonCode(AI分類)を別列にする。
/// [既知の簡略化] 現行UIには構造化選択肢UIも自由記述AI分類パイプラインも無いため、
/// reasonCode/aiClassifiedReasonCodeは常にnull、freeTextのみが実際に埋まる。
model ExecutionReasonAnswer {
  id                     String       @id @default(uuid())
  workspaceId            String       @map("workspace_id")
  subjectUserId          String       @map("subject_user_id")
  promptId               String       @map("prompt_id")
  prompt                 ReasonPrompt @relation(fields: [promptId], references: [id])
  triggerEventId         String       @map("trigger_event_id")
  /// 本人が選択したReason種別コード。現行UIには構造化選択肢が無いため常にnull。
  reasonCode             String?      @map("reason_code")
  /// 自由記述からAIが分類したReason種別コード。分類パイプライン未実装のため常にnull。
  aiClassifiedReasonCode String?      @map("ai_classified_reason_code")
  freeText               String?      @map("free_text")
  structuredDetail       Json?        @map("structured_detail")
  questionVersion        String       @map("question_version")
  /// 訂正時、旧回答を指す(insert-only revision chain、v4.0 8.1節と同じ考え方)。
  /// 現状回答訂正UIが無いため常にnull。
  revisionOfAnswerId     String?      @map("revision_of_answer_id")
  answeredAt             DateTime     @map("answered_at")
  createdAt              DateTime     @default(now()) @map("created_at")

  @@index([promptId])
  @@map("execution_reason_answers")
}

/// TBL(PEM Phase 0E-2) bootstrap_assertions - Bootstrap Assertion
/// [出典: PEMサブシステム統合正本仕様書v4.0 11章]
/// insert-only。SELF_REPORT/INITIAL_HYPOTHESIS/DECLARED_CONSTRAINT/
/// INTERVENTION_PREFERENCEを区別する。「AssertionとsourceAnswerを中間テーブルで
/// 結ぶ」とあるが、現行の初回対話には構造化Answerが存在しない(自由対話形式)ため、
/// 代わりに昇格元のPemObservation(FACT)/PemHypothesisへ直接参照する
/// (最も近い誠実な代替。詳細は本パッチのdocstring参照)。
/// [現状の制約] SELF_REPORT/INITIAL_HYPOTHESISのみ、初回対話のREVIEW確認完了時に
/// 実際に作成される。DECLARED_CONSTRAINT/INTERVENTION_PREFERENCEはそれを生成する
/// UI・フローが無いため、型としては用意するが未使用。
model BootstrapAssertion {
  id                    String    @id @default(uuid())
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id])
  /// SELF_REPORT/INITIAL_HYPOTHESIS/DECLARED_CONSTRAINT/INTERVENTION_PREFERENCE
  assertionType         String    @map("assertion_type")
  statement             String
  /// このAssertionの根拠となったPemObservation(FACT)。SELF_REPORT型のみ設定。
  sourceObservationId   String?   @map("source_observation_id")
  /// このAssertionの根拠となったPemHypothesis。INITIAL_HYPOTHESIS型のみ設定。
  sourceHypothesisId    String?   @map("source_hypothesis_id")
  /// 由来する初回対話。
  conversationId        String?   @map("conversation_id")
  /// ACTIVE/EXPIRED/SUPERSEDED/WITHDRAWN [推論。v4.0は「status及びsupersession」と
  /// のみ記載し正式な値集合の明記が無いため、Hypothesis状態(12.2節)の考え方に
  /// 揃えて導出した]。
  status                String    @default("ACTIVE")
  expiresAt             DateTime? @map("expires_at")
  /// insert-only revision chain。新Assertionがこれを置き換える場合、新側の
  /// supersedesAssertionIdに旧AssertionのIDを入れる(旧行はUPDATEしない)。
  supersedesAssertionId String?   @map("supersedes_assertion_id")
  createdAt             DateTime  @default(now()) @map("created_at")

  @@index([userId, assertionType])
  @@map("bootstrap_assertions")
}

/// TBL-019 evidences - 完了等の証拠候補 [推論]
model Evidence {
  id               String          @id @default(uuid())
  responsibilityId String?         @map("responsibility_id")
  responsibility   Responsibility? @relation(fields: [responsibilityId], references: [id])
  sourceType       String          @map("source_type")
  sourceRef        String?         @map("source_ref")
  capturedAt       DateTime?       @map("captured_at")
  confidence       Decimal?        @db.Decimal(4, 3)
  /// CANDIDATE/CONFIRMED/REJECTED [推論]
  status           String          @default("CANDIDATE")
  createdAt        DateTime        @default(now()) @map("created_at")

  pemEvidenceLinks PemEvidenceLink[]

  @@map("evidences")
}

// =====================================================================
// MOD-08 Notification / MOD-09 Privacy / MOD-11 Integration / MOD-10 Admin
// =====================================================================

/// TBL-021 notifications [推論]
model Notification {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id])
  /// DEADLINE/FOLLOW_UP/RISK等 [推論]
  type        String
  dedupeKey   String    @map("dedupe_key")
  payload     Json
  channel     String    @default("IN_APP")
  /// SCHEDULED/SENT/READ/SUPPRESSED [推論]
  status      String    @default("SCHEDULED")
  scheduledAt DateTime  @map("scheduled_at")
  sentAt      DateTime? @map("sent_at")
  readAt      DateTime? @map("read_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@unique([dedupeKey])
  @@index([userId, status])
  @@map("notifications")
}

/// TBL-022 consents（FN-PRV-02対応）
model Consent {
  id          String    @id @default(uuid())
  captureId   String?   @map("capture_id")
  subjectId   String    @map("subject_id")
  purpose     String
  scope       Json
  grantedAt   DateTime  @default(now()) @map("granted_at")
  expiresAt   DateTime? @map("expires_at")
  withdrawnAt DateTime? @map("withdrawn_at")

  captures Capture[]

  @@map("consents")
}

/// TBL-023 integrations - 外部連携メタデータ（P6予約）[推論]
model Integration {
  id          String    @id @default(uuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  provider    String
  scope       Json
  /// CONNECTED/REVOKED [推論]
  status      String    @default("CONNECTED")
  connectedAt DateTime  @default(now()) @map("connected_at")
  revokedAt   DateTime? @map("revoked_at")

  @@map("integrations")
}

/// TBL-024 audit_logs - 管理・権限・外部操作 [推論]
model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String?  @map("actor_user_id")
  actorUser   User?    @relation("AuditActorUser", fields: [actorUserId], references: [id])
  actorType   String   @map("actor_type")
  action      String
  targetType  String   @map("target_type")
  targetId    String?  @map("target_id")
  /// SUCCESS/FAILURE [推論]
  result      String
  reason      String?
  ipAddress   String?  @map("ip_address")
  occurredAt  DateTime @default(now()) @map("occurred_at")

  @@index([targetType, targetId])
  @@map("audit_logs")
}

// =====================================================================
// V5-M1-A1 Project Context Domain基盤
// 出典: ISMAY-V5-DOC-04(Project Context・外部連携境界仕様書) 2章・3章、
//       ISMAY-V5-DOC-10(DB物理設計書) 3.2節、ISMAY_統合正本仕様書_v5_0 8章。
// 範囲: DBモデルのみ(M1-A1)。API/UI/Formation/Atomicity/Case Patternは対象外。
//
// [DEC-1] ProjectContext.kind列は追加しない。統合正本仕様書8.4節は`kind`列を
//   例示するが、29章2項「Context kind/lifecycleの最終Code Registry」は未確定と
//   明記されており、対応分冊確定まで実装着手不可とされている。
// [DEC-2] visibilityの既定値はDOC-04に明記が無いため、最も制限的な"PRIVATE"を
//   既定とする(DOC-02 4章のVisibility Code、既存PemConsent等の
//   「既定非公開」原則に整合させた実装判断)。
// [DEC-3] description列名はDOC-04 2章の表記に従う(統合正本仕様書8.4節の
//   "summary"と同一概念。DOC-04が本Gateの直接対象subvolumeのためこちらを採用)。
// [DEC-4] ExternalContextReferenceの識別子はDOC-04 2章の表記
//   (externalWorkspaceKey, externalProjectKey)に従う。DOC-04 5章の
//   「provider=MERIDIAN, externalProjectKey, externalItemKey」はFormation
//   Materialization時にResponsibility側が持つ識別子を指すと解釈し、
//   ExternalContextReference(Context単位の参照)の列とは別領域として扱う
//   (M1-B以降で要再確認)。
// [DEC-5] direction/syncPolicy/statusの具体的許容値はDOC-04のどの章にも
//   列挙されておらず、統合正本仕様書29章6項「External connector別scope、
//   credential、replay防止」も未確定事項に指定されている。このためString列
//   のみとし、Code Registryは値確定後の別Gateで追加する。
// =====================================================================

/// V5-DOC-04 2章 TBL: project_contexts
model ProjectContext {
  id                 String    @id @default(uuid())
  workspaceId        String    @map("workspace_id")
  workspace          Workspace @relation(fields: [workspaceId], references: [id])
  domainId           String    @map("domain_id")
  domain             Domain    @relation(fields: [domainId, workspaceId], references: [id, workspaceId])
  /// 観測対象(DOC-02 4章 subjectUserId原則)。統合正本仕様書8.4節のownerSubjectUserId。
  ownerSubjectUserId String    @map("owner_subject_user_id")
  ownerSubjectUser   User      @relation("ProjectContextOwner", fields: [ownerSubjectUserId], references: [id])
  name               String
  /// DOC-04 2章の表記。統合正本仕様書8.4節の"summary"と同一概念([DEC-3])。
  description        String?
  /// ACTIVE/PAUSED/COMPLETED/ARCHIVED(PROJECT_CONTEXT_LIFECYCLE_STATES)。
  lifecycleState     String    @default("ACTIVE") @map("lifecycle_state")
  /// PRIVATE/CONTEXT/WORKSPACE/EXPLICIT(VISIBILITIES)。既定[DEC-2]。
  visibility         String    @default("PRIVATE")
  startedAt          DateTime? @map("started_at")
  targetEndAt        DateTime? @map("target_end_at")
  version            Int       @default(0)
  createdById        String    @map("created_by")
  createdBy          User      @relation("ProjectContextCreatedBy", fields: [createdById], references: [id])
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")

  links              ProjectContextLink[]
  linkEvents         ProjectContextLinkEvent[]
  externalReferences ExternalContextReference[]
  embeddings         ProjectContextEmbedding[]

  /// [tenant境界二重防御] 既存Responsibility/BulkCompleteReceipt等と同じ複合unique方式。
  @@unique([id, workspaceId], map: "project_contexts_id_workspace_uq")
  @@index([workspaceId, lifecycleState])
  @@index([workspaceId, domainId])
  @@map("project_contexts")
}

/// V5-DOC-04 2章 TBL: project_context_links
/// 現在アクティブなLinkの高速参照用テーブル。履歴の正本は
/// ProjectContextLinkEvent(append-only)であり、本テーブルは
/// そのProjectionに相当する(EventLog正本→Projection実体化と同じ設計原則)。
model ProjectContextLink {
  id               String         @id @default(uuid())
  workspaceId      String         @map("workspace_id")
  contextId        String         @map("context_id")
  context          ProjectContext @relation(fields: [contextId, workspaceId], references: [id, workspaceId])
  responsibilityId String         @map("responsibility_id")
  responsibility   Responsibility @relation(fields: [responsibilityId, workspaceId], references: [id, workspaceId])
  /// PRIMARY/SUPPORTING/REFERENCE(PROJECT_CONTEXT_LINK_ROLES)。
  role             String
  /// USER/AI/IMPORT/SYSTEM。既存Responsibility.sourceKindと同じ語彙を再利用する。
  sourceKind       String         @map("source_kind")
  linkedAt         DateTime       @default(now()) @map("linked_at")
  unlinkedAt       DateTime?      @map("unlinked_at")
  createdAt        DateTime       @default(now()) @map("created_at")

  /// active PRIMARY一意制約・(Context,Responsibility)組の一意制約はいずれも
  /// Prismaのpartial unique非対応のためmigration.sqlで明示追加する(DOC-04 10章)。
  @@index([workspaceId, contextId, unlinkedAt, role])
  @@index([workspaceId, responsibilityId, unlinkedAt])
  @@map("project_context_links")
}

/// V5-DOC-04 2章 TBL: project_context_link_events(append-only)
model ProjectContextLinkEvent {
  id                 String         @id @default(uuid())
  workspaceId        String         @map("workspace_id")
  contextId          String         @map("context_id")
  context            ProjectContext @relation(fields: [contextId, workspaceId], references: [id, workspaceId])
  responsibilityId   String         @map("responsibility_id")
  responsibility     Responsibility @relation(fields: [responsibilityId, workspaceId], references: [id, workspaceId])
  /// LINK/UNLINK(統合正本仕様書8.4節 action)。
  eventType          String         @map("event_type")
  /// このEvent発生時点のrole。
  role               String
  beforeSnapshot     Json?          @map("before_snapshot")
  afterSnapshot      Json?          @map("after_snapshot")
  /// actorType=USERの場合のみ非null(DB CHECKで排他性を保証。DOC-10 6章)。
  actorUserId        String?        @map("actor_user_id")
  actorType          String         @map("actor_type")
  idempotencyKey     String         @map("idempotency_key")
  requestPayloadHash String         @map("request_payload_hash")
  occurredAt         DateTime       @default(now()) @map("occurred_at")

  @@unique([workspaceId, contextId, idempotencyKey], map: "pcle_idempotency_uq")
  @@index([workspaceId, responsibilityId])
  @@map("project_context_link_events")
}

/// V5-DOC-04 2章 TBL: external_context_references
model ExternalContextReference {
  id                   String         @id @default(uuid())
  workspaceId          String         @map("workspace_id")
  contextId            String         @map("context_id")
  context              ProjectContext @relation(fields: [contextId, workspaceId], references: [id, workspaceId])
  provider             String
  externalWorkspaceKey String         @map("external_workspace_key")
  externalProjectKey   String         @map("external_project_key")
  canonicalUrl         String?        @map("canonical_url")
  /// [DEC-5] 許容値未確定。String列のみ、値検証は別Gateで追加。
  direction            String
  syncPolicy           String         @map("sync_policy")
  status               String
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")

  snapshotRevisions ProjectContextSnapshotRevision[]

  /// [tenant境界二重防御] ProjectContextSnapshotRevisionからの複合FK参照先。
  @@unique([id, workspaceId], map: "ecr_id_workspace_uq")
  /// DOC-04 2章「provider/key unique」。
  @@unique([workspaceId, provider, externalWorkspaceKey, externalProjectKey], map: "ecr_provider_key_uq")
  @@index([workspaceId, contextId])
  @@map("external_context_references")
}

/// V5-DOC-04 2章 TBL: project_context_snapshot_revisions
/// immutable、revision単調増加。referenceId(ExternalContextReference)への
/// 取得時点Snapshotであり、Context本体のSnapshotではない([DEC-4]参照)。
model ProjectContextSnapshotRevision {
  id            String                   @id @default(uuid())
  workspaceId   String                   @map("workspace_id")
  referenceId   String                   @map("reference_id")
  reference     ExternalContextReference @relation(fields: [referenceId, workspaceId], references: [id, workspaceId])
  revision      Int
  sourceVersion String?                  @map("source_version")
  payload       Json
  payloadHash   String                   @map("payload_hash")
  capturedAt    DateTime                 @default(now()) @map("captured_at")
  expiresAt     DateTime?                @map("expires_at")

  @@unique([referenceId, workspaceId, revision], map: "pcsr_reference_revision_uq")
  @@map("project_context_snapshot_revisions")
}

/// V5-DOC-04 2章 TBL: project_context_embeddings(1 current/model)
/// 既存ResponsibilityEmbeddingと同じUnsupported("vector(1536)")方式を踏襲する。
model ProjectContextEmbedding {
  id            String                      @id @default(uuid())
  workspaceId   String                      @map("workspace_id")
  contextId     String                      @map("context_id")
  context       ProjectContext              @relation(fields: [contextId, workspaceId], references: [id, workspaceId])
  model         String
  dimensions    Int
  sourceVersion Int                         @map("source_version")
  /// pgvector型。previewFeatures=postgresqlExtensions前提でPrismaは型検証をスキップする
  /// (ResponsibilityEmbeddingと同じ注記)。
  embedding     Unsupported("vector(1536)")
  updatedAt     DateTime                    @updatedAt @map("updated_at")

  /// 1 current/model(DOC-04 2章)。
  @@unique([workspaceId, contextId, model], map: "pce_context_model_uq")
  @@map("project_context_embeddings")
}

// =====================================================================
// V5-M1-B1 Formation Session Domain基盤
// 出典: ISMAY-V5-DOC-03(Formation Session仕様書) 3章・4章・5章、
//       ISMAY-V5-DOC-02(用語・状態・EventCode定義書) 6章・7.3節、
//       ISMAY-V5-DOC-10(DB物理設計書) 3.1節・5章・6章。
//
// このGate(M1-B1)はDOC-03 10章「M1-B1はshadow Session生成のみ」の
// DB/domain基盤部分に対応する。API/UI/既存Capture・AI抽出フローへの実配線
// (CHG-010〜012)は後続Gateで行い、本migrationはtable/制約の新設のみ行う
// (expand-only、既存Capture/AiInferenceフローへの挙動変更は無い)。
//
// [DEC-008] DOC-03 4章はFormationLearningEventも論理Entityとして列挙するが、
//   DOC-10 3.1節が明記する物理table一覧(10table)には含まれていない
//   (「LearningはM1-Bでは専用tableを推奨」という留保付き記述のみ)。
//   学習Event書込はCHG-015(Capture解析同意とFormation Learning同意の分離)に
//   依存し、その同意モデルはこのGateでは未確定のため、FormationLearningEventの
//   実装はこのGateでは行わない(想像で同意設計を先取りしない。DOC-13 7章の
//   未確定事項運用方針に従う)。
// =====================================================================

/// V5-DOC-03 4章 TBL: formation_sessions
model FormationSession {
  id               String    @id @default(uuid())
  workspaceId      String    @map("workspace_id")
  workspace        Workspace @relation(fields: [workspaceId], references: [id])
  domainId         String    @map("domain_id")
  domain           Domain    @relation(fields: [domainId, workspaceId], references: [id, workspaceId])
  subjectUserId    String    @map("subject_user_id")
  subjectUser      User      @relation(fields: [subjectUserId], references: [id])
  captureId        String    @map("capture_id")
  capture          Capture   @relation(fields: [captureId, workspaceId], references: [id, workspaceId])
  /// POST /formation-sessions のIdempotency-Keyヘッダ値(DOC-03 7章)。
  /// 同一(workspace,capture,key)の再送は新規Session生成しない。
  clientSessionKey String    @map("client_session_key")
  /// DRAFT/ANALYZING/CLARIFYING/REVIEW_READY/PARTIALLY_CONFIRMED/CONFIRMED/
  /// DISMISSED/DEFERRED/FAILED(DOC-02 6章、DOC-03 3章状態機械)。
  state            String    @default("DRAFT")
  version          Int       @default(0)
  /// CLARIFYING中に作成済みのFormationQuestion数(上限3、DOC-03 3章Guard)。
  questionCount    Int       @default(0) @map("question_count")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  events               FormationSessionEvent[]
  candidates           FormationCandidateIdentity[]
  questions            FormationQuestion[]
  receipts             MaterializationReceipt[]
  /// [R1-03新設・監査是正指示書2026-08-31] FormationCandidateMergeEvent.session
  /// 複合FKの逆側(Prismaは両側の宣言が必須)。
  candidateMergeEvents FormationCandidateMergeEvent[]
  /// [M1-B6B新設・2026-08-31指示書 Session Lifecycle]
  lifecycleEvents      FormationSessionLifecycleEvent[]

  /// Idempotency-Key再送検出用(DOC-03 7章 POST /formation-sessions)。
  @@unique([workspaceId, captureId, clientSessionKey], map: "formation_sessions_idempotency_uq")
  /// 子テーブルからの複合FK(sessionId, workspaceId)参照先として必要
  /// (既存Responsibility/ProjectContext等と同じtenant境界二重防御方式)。
  @@unique([id, workspaceId], map: "formation_sessions_id_workspace_uq")
  @@index([workspaceId, captureId])
  @@index([workspaceId, state])
  @@map("formation_sessions")
}

/// V5-DOC-03 4章 TBL: formation_session_events(append-only、Session全体timeline)
model FormationSessionEvent {
  id          String           @id @default(uuid())
  workspaceId String           @map("workspace_id")
  sessionId   String           @map("session_id")
  session     FormationSession @relation(fields: [sessionId, workspaceId], references: [id, workspaceId])
  /// (sessionId,sequence)でunique(DOC-10 5章「Formation timeline」)。
  sequence    Int
  /// DOC-02 7.3節Formation Event Catalog(16種)+R1-04新設CANDIDATE_SPLIT/
  /// CANDIDATE_MERGED(coreTypes.ts FORMATION_EVENT_TYPES参照、計18種)のいずれか。
  eventType   String           @map("event_type")
  /// actorType=USERの場合のみactorUserId必須(DOC-10 6章「actorTypeとactor IDの排他」、
  /// ProjectContextLinkEventと同じ設計)。ANALYSIS_REQUESTED等はSYSTEM/AI起点もありうる。
  actorType   String           @map("actor_type")
  actorUserId String?          @map("actor_user_id")
  actorUser   User?            @relation(fields: [actorUserId], references: [id])
  payload     Json
  occurredAt  DateTime         @default(now()) @map("occurred_at")

  askedByQuestions FormationQuestion[]

  @@unique([sessionId, sequence], map: "formation_session_events_session_sequence_uq")
  @@index([workspaceId, sessionId])
  @@map("formation_session_events")
}

/// V5-DOC-03 4章 TBL: formation_candidate_identities(Session内安定ID)
model FormationCandidateIdentity {
  id              String           @id @default(uuid())
  workspaceId     String           @map("workspace_id")
  sessionId       String           @map("session_id")
  session         FormationSession @relation(fields: [sessionId, workspaceId], references: [id, workspaceId])
  /// Session内で安定した識別子(例: "c1","c2"。UI・回答Eventが再解析後も同じ候補を指すため)。
  candidateKey    String           @map("candidate_key")
  /// 最新のCandidateRevision.revision値(Projectionの高速参照用。正本はrevision行そのもの)。
  currentRevision Int              @default(0) @map("current_revision")
  createdAt       DateTime         @default(now()) @map("created_at")

  revisions                FormationCandidateRevision[]
  questions                FormationQuestion[]
  receiptItems             MaterializationReceiptItem[]
  decisionEvents           FormationCandidateDecisionEvent[]
  /// [2026-08-30新設・M1-C2B] このIdentityが親としてMerge/Splitのlineageに現れる場合。
  lineageAsParent          FormationCandidateLineage[]       @relation("LineageParentIdentity")
  /// [2026-08-30新設・M1-C2B] このIdentityがMerge操作の結果として作られた場合。
  mergeEventAsNewCandidate FormationCandidateMergeEvent[]    @relation("MergeEventNewCandidate")

  @@unique([sessionId, candidateKey], map: "formation_candidate_identities_session_key_uq")
  @@unique([id, workspaceId], map: "formation_candidate_identities_id_workspace_uq")
  @@map("formation_candidate_identities")
}

/// V5-DOC-03 4章 TBL: formation_candidate_revisions(immutable、revision単調増加)
model FormationCandidateRevision {
  id             String                     @id @default(uuid())
  workspaceId    String                     @map("workspace_id")
  candidateId    String                     @map("candidate_id")
  candidate      FormationCandidateIdentity @relation(fields: [candidateId, workspaceId], references: [id, workspaceId])
  revision       Int
  /// 9種責任型のいずれか(TASK/COMMITMENT/DECISION/WAITING/EVENT/RISK/CONCERN/HABIT/IDEA)。
  /// 既存Responsibility.typeと同じ「plain string、narrow unionにしない」方針を踏襲する。
  type           String
  title          String
  description    String?
  /// AI提案のResponsibility種別固有fields(TaskDetail/CommitmentDetail等相当)の下書き。
  proposedFields Json                       @map("proposed_fields")
  /// DOC-10 4章 v5列パターン「Confidence numeric(5,4), 0<=x<=1」。
  confidence     Decimal                    @db.Decimal(5, 4)
  schemaVersion  String                     @map("schema_version")
  createdAt      DateTime                   @default(now()) @map("created_at")

  sourceAnchors           FormationSourceAnchor[]
  decisionEvents          FormationCandidateDecisionEvent[]
  receiptItems            MaterializationReceiptItem[]
  atomicityAssessments    FormationAtomicityAssessment[]
  /// [2026-08-30新設・M1-C2A] SHOULD_DECOMPOSE/CONTEXT_LIKEなRevisionに対する
  /// 本人の明示override(Materialize Guardの解除)。
  atomicityOverrides      FormationAtomicityOverride[]
  /// [2026-08-30新設・M1-C2B] このRevisionが子(Merge/Split結果)である場合のlineage。
  lineageAsChild          FormationCandidateLineage[]       @relation("LineageChildRevision")
  /// [2026-08-30新設・M1-C2B] このRevisionが親の決定時点Revisionとしてlineageに現れる場合。
  lineageAsParentRevision FormationCandidateLineage[]       @relation("LineageParentRevision")

  @@unique([candidateId, revision], map: "formation_candidate_revisions_candidate_revision_uq")
  @@unique([id, workspaceId], map: "formation_candidate_revisions_id_workspace_uq")
  /// [R1-03新設・監査是正指示書2026-08-31] FormationCandidateLineage.parentRevisionが
  /// parentIdentityに実際に属することをDB複合FKで保証するための参照先。
  @@unique([id, candidateId, workspaceId], map: "formation_candidate_revisions_id_candidate_workspace_uq")
  @@map("formation_candidate_revisions")
}

/// V5-DOC-03 4章 TBL: formation_source_anchors(原文位置根拠)
model FormationSourceAnchor {
  id          String                     @id @default(uuid())
  workspaceId String                     @map("workspace_id")
  revisionId  String                     @map("revision_id")
  revision    FormationCandidateRevision @relation(fields: [revisionId, workspaceId], references: [id, workspaceId])
  /// TEXT_OFFSET/AUDIO_TIMECODE/MEETING_SPEAKER/IMAGE_BBOX(M1-LOC機能、
  /// HANDOFF v1 M1「Text offset、音声timecode、会議speaker、画像page/bbox Adapter」)。
  sourceKind  String                     @map("source_kind")
  captureId   String                     @map("capture_id")
  capture     Capture                    @relation(fields: [captureId, workspaceId], references: [id, workspaceId])
  /// TEXT_OFFSET用。DOC-10 6章「0<=start<end<=sourceLength」のうちDB CHECKで
  /// 保証できるのはstart>=0・end>startまで(sourceLengthはCapture側の値のため
  /// application層で追加検証する)。
  startOffset Int?                       @map("start_offset")
  endOffset   Int?                       @map("end_offset")
  /// IMAGE_BBOX用。DOC-10 6章「画像regionは0..1」の正規化座標をJSONで保持。
  imageRegion Json?                      @map("image_region")
  excerptHash String                     @map("excerpt_hash")

  /// [M1-B6A新設・2026-08-31指示書§3.2.1「正規化Source Unit」]
  /// AUDIO_TIMECODE/MEETING_SPEAKER用。文字起こしsegment内でのミリ秒offset。
  audioStartMs     Int?     @map("audio_start_ms")
  audioEndMs       Int?     @map("audio_end_ms")
  /// AUDIO_TIMECODE/MEETING_SPEAKER用。Provider応答内でのsegment通し番号
  /// (0始まり)。同一segmentから複数candidateのevidenceが作られる場合の
  /// 突合せに使う。
  segmentIndex     Int?     @map("segment_index")
  /// MEETING_SPEAKER用。Provider(diarization機能付き)が返す話者ラベル
  /// (例: "Speaker A")。Providerによっては提供されない値のため、その場合は
  /// nullのままqualityをUNAVAILABLEとする(捏造しない)。
  speakerLabel     String?  @map("speaker_label")
  /// MEETING_SPEAKER用。speakerLabelが本人により確認・修正済みかどうか
  /// (診断・信頼度表示用。確認は次GateのUIで扱う。この列自体は今回のGateで
  /// 予約するがtrue/falseを能動的に設定する経路はまだ無い)。
  speakerConfirmed Boolean? @map("speaker_confirmed")
  /// IMAGE_BBOX用。複数ページ画像入力(ocrProvider.ts AiOcrInput.images)の
  /// うち何ページ目由来かを示す(0始まり、Provider入力時のページ順と対応)。
  pageIndex        Int?     @map("page_index")
  /// IMAGE_BBOX用。OCR結果の信頼度(0..1)。Providerが返す場合のみ設定。
  ocrConfidence    Decimal? @map("ocr_confidence") @db.Decimal(4, 3)

  /// [M1-B6A新設] このAnchorの根拠としての質。§3.2.2「Providerがtimecode/bbox/
  /// speakerを返さない場合は、それを捏造しない。UNAVAILABLE品質として保存し、
  /// Text Anchorへ安全にfallbackする」。AVAILABLE=kind固有fieldが実在する形で
  /// 取得できた。UNAVAILABLE=Provider応答にkind固有情報が無かった(この場合、
  /// kind固有fieldは全てnullのまま、unavailableReasonに理由を記録する)。
  quality             String  @default("AVAILABLE") @map("quality")
  /// quality=UNAVAILABLEの場合のみ必須(DB CHECKで強制)。例:
  /// "PROVIDER_NO_DIARIZATION"(話者分離非対応Provider)、
  /// "PROVIDER_NO_TIMECODE"(timecode非対応Provider)等。想像で理由を作らず、
  /// 呼出元(Provider Adapter)が実際に判定した理由をそのまま記録する。
  unavailableReason   String? @map("unavailable_reason")
  /// この正規化Source Unit契約自体のversion("1.0"固定。将来fieldを追加する
  /// 場合はversionを上げ、旧versionの行は読み取り時にdual-readする)。
  anchorSchemaVersion String  @default("1.0") @map("anchor_schema_version")

  /// pem/coreTypes.tsのPiiClassification語彙を再利用する(新規語彙を発明しない)。
  /// [R1-05是正・監査是正指示書2026-08-31] NONE/UNCLASSIFIEDを混同しない
  /// (piiClassifier.ts参照)。DB CHECK制約(migration 20260831040000)で
  /// NONE/LOW/MEDIUM/HIGH/UNCLASSIFIEDの5値のみへ制限している。
  piiClassification String   @map("pii_classification")
  createdAt         DateTime @default(now()) @map("created_at")

  @@index([workspaceId, revisionId])
  @@map("formation_source_anchors")
}

/// V5-DOC-03 4章 TBL: formation_questions(最大3件、ordinal 1..3)
model FormationQuestion {
  id            String                      @id @default(uuid())
  workspaceId   String                      @map("workspace_id")
  sessionId     String                      @map("session_id")
  session       FormationSession            @relation(fields: [sessionId, workspaceId], references: [id, workspaceId])
  candidateId   String?                     @map("candidate_id")
  candidate     FormationCandidateIdentity? @relation(fields: [candidateId, workspaceId], references: [id, workspaceId])
  /// 1..3(DOC-03 3章Guard「questionCount<=3」、EV-F-002「4問目拒否」)。
  ordinal       Int
  questionCode  String                      @map("question_code")
  promptVersion String                      @map("prompt_version")
  /// [2026-08-30新設・M1-B5a §3.2] 統合正本§6.6「質問本文」。questionCode+promptVersionは
  /// テンプレートの識別key、promptTextはask時点でcandidate情報等を埋め込んで確定した
  /// 実際の表示文そのもののsnapshot(再現可能性のため、後からテンプレートを差し替えても
  /// 過去のQuestionの表示文は不変)。
  promptText    String                      @map("prompt_text")
  /// [2026-08-30新設・M1-B5a §3.1] P0/P1/P2(統合正本§6.4優先順位)。
  priority      String
  /// [2026-08-30新設・M1-B5a §3.1] このQuestionが選ばれた理由を示す短いcode
  /// (CandidateDecisionEvent.reasonCode等、既存の「code、詳細文はUI側」方式を踏襲)。
  reasonCode    String                      @map("reason_code")
  /// [2026-08-30新設・M1-B5a §3.1] 統合正本§6.4
  /// 「ambiguity × downstreamImpact × errorRisk - answerCost」の算出値そのもの
  /// (score算出の各成分はQuestion Policy関数側でtestする。ここではaudit・tie-break
  /// 根拠として最終scoreだけを保持する)。
  scoreValue    Decimal                     @map("score_value") @db.Decimal(7, 4)
  askedEventId  String?                     @map("asked_event_id")
  askedEvent    FormationSessionEvent?      @relation(fields: [askedEventId], references: [id])
  createdAt     DateTime                    @default(now()) @map("created_at")

  answerEvents FormationAnswerEvent[]

  @@unique([sessionId, ordinal], map: "formation_questions_session_ordinal_uq")
  @@unique([id, workspaceId], map: "formation_questions_id_workspace_uq")
  @@map("formation_questions")
}

/// V5-DOC-03 4章 TBL: formation_answer_events(append-only、訂正はrevisionOf)
model FormationAnswerEvent {
  id            String                 @id @default(uuid())
  workspaceId   String                 @map("workspace_id")
  questionId    String                 @map("question_id")
  question      FormationQuestion      @relation(fields: [questionId, workspaceId], references: [id, workspaceId])
  /// SELECTED/FREE_TEXT/UNKNOWN/DEFERRED/DO_NOT_MATERIALIZE(統合正本v5.0 §6.4)。
  /// [2026-08-30是正] 旧DOC-02語彙のANSWERED(選択式・自由文を区別しなかった)から、
  /// 統合正本§6.4のSELECTED/FREE_TEXT分離語彙へ移行(migration
  /// 20260830010000_formation_question_answer_v5_contract_normalization)。
  answerKind    String                 @map("answer_kind")
  valueJson     Json?                  @map("value_json")
  /// DOC-03 4章では単一必須fieldとして定義(質問への回答は常に本人。
  /// FormationSessionEventのような汎用actorType化はしない)。
  actorUserId   String                 @map("actor_user_id")
  actorUser     User                   @relation(fields: [actorUserId], references: [id])
  occurredAt    DateTime               @default(now()) @map("occurred_at")
  /// 訂正時は新規行を追加し、元の回答行を指す(UPDATE禁止、append-only)。
  revisionOfId  String?                @map("revision_of_id")
  revisionOf    FormationAnswerEvent?  @relation("FormationAnswerCorrection", fields: [revisionOfId], references: [id])
  corrections   FormationAnswerEvent[] @relation("FormationAnswerCorrection")
  /// [2026-08-30新設・M1-B5a §3.2] POST /:id/answers の冪等性key
  /// (統合正本DOC-03 §7「POST /:id/answers | 回答Event追加 | clientEventId unique」)。
  /// (workspaceId, actorUserId, clientEventId)でtenant+本人scopeの一意性を持たせる
  /// (既存captures.clientDraftIdの(workspaceId, createdById, clientDraftId)パターンを踏襲)。
  clientEventId String                 @map("client_event_id")

  @@unique([workspaceId, actorUserId, clientEventId], map: "formation_answer_events_workspace_actor_client_event_uq")
  @@index([workspaceId, questionId])
  @@map("formation_answer_events")
}

/// V5-DOC-03 4章 TBL: formation_candidate_decision_events
model FormationCandidateDecisionEvent {
  id          String                     @id @default(uuid())
  workspaceId String                     @map("workspace_id")
  candidateId String                     @map("candidate_id")
  candidate   FormationCandidateIdentity @relation(fields: [candidateId, workspaceId], references: [id, workspaceId])
  /// 採否対象Revisionを固定する(DOC-03 4章「採否対象Revisionを固定」、
  /// EV-F-003「承認Revisionが暗黙更新されない」)。
  revisionId  String                     @map("revision_id")
  revision    FormationCandidateRevision @relation(fields: [revisionId, workspaceId], references: [id, workspaceId])
  /// ACCEPTED/REJECTED/DEFERRED/DO_NOT_MATERIALIZE/SPLIT/MERGED(DOC-02 6章
  /// CandidateDecisionのうちPENDINGを除く。PENDINGは「未決定」を表す既定状態であり
  /// Eventとしては記録しない、という設計判断)。[2026-08-30追加・M1-C]
  /// SPLIT/MERGEDは統合正本§6.6・§11.4対応で追加(migration
  /// 20260830040000_formation_split_decision_vocabulary)。SPLITは
  /// splitCorrection.ts専用、MERGEDは値のみ予約(transaction本体は未実装、
  /// coreTypes.ts CANDIDATE_DECISION_EVENT_VALUESコメント参照)。
  decision    String
  reasonCode  String?                    @map("reason_code")
  /// DOC-03 4章では単一必須field(本人承認なしのResponsibility生成0件、という
  /// 受入条件と対応するため、actorTypeによるSYSTEM/AI採否は許容しない)。
  actorUserId String                     @map("actor_user_id")
  actorUser   User                       @relation(fields: [actorUserId], references: [id])
  occurredAt  DateTime                   @default(now()) @map("occurred_at")

  /// [2026-08-29追加・B3.1是正B31-04/B31-06] 採否対象Revisionは1候補につき1回だけ
  /// 固定される(=1候補につきDecision Eventは高々1件)という不変条件を、
  /// application層の事前SELECT(ALREADY_DECIDED判定)だけでなくDB制約でも保証する。
  /// 主防御はmaterialize.ts側のSession行FOR UPDATE lockによる直列化だが、
  /// 万一lockを経由しない書込み経路が将来追加された場合の多層防御として追加する。
  @@unique([workspaceId, candidateId], map: "formation_candidate_decision_events_workspace_candidate_uq")
  @@index([workspaceId, candidateId])
  @@map("formation_candidate_decision_events")
}

/// V5-DOC-03 4章 TBL: materialization_receipts
model MaterializationReceipt {
  id          String           @id @default(uuid())
  workspaceId String           @map("workspace_id")
  sessionId   String           @map("session_id")
  session     FormationSession @relation(fields: [sessionId, workspaceId], references: [id, workspaceId])
  /// クライアント指定の一括確定操作ID(DOC-03 6章2「operationIdとrequestHashの
  /// 冪等性を検証。同一key異payloadは409」)。
  operationId String           @map("operation_id")
  requestHash String           @map("request_hash")
  committedAt DateTime         @default(now()) @map("committed_at")

  items MaterializationReceiptItem[]

  @@unique([workspaceId, operationId], map: "materialization_receipts_operation_uq")
  @@unique([id, workspaceId], map: "materialization_receipts_id_workspace_uq")
  @@map("materialization_receipts")
}

/// V5-DOC-03 4章 TBL: materialization_receipt_items(1候補1生成)
model MaterializationReceiptItem {
  id                  String                     @id @default(uuid())
  workspaceId         String                     @map("workspace_id")
  receiptId           String                     @map("receipt_id")
  receipt             MaterializationReceipt     @relation(fields: [receiptId, workspaceId], references: [id, workspaceId])
  candidateId         String                     @map("candidate_id")
  candidate           FormationCandidateIdentity @relation(fields: [candidateId, workspaceId], references: [id, workspaceId])
  candidateRevisionId String                     @map("candidate_revision_id")
  candidateRevision   FormationCandidateRevision @relation(fields: [candidateRevisionId, workspaceId], references: [id, workspaceId])
  responsibilityId    String                     @map("responsibility_id")
  responsibility      Responsibility             @relation(fields: [responsibilityId, workspaceId], references: [id, workspaceId])

  /// [2026-08-29修正・B3.1是正B31-01] 旧`@@unique([receiptId, candidateId])`は
  /// 同一Receipt内の重複しか防げず、異なるReceipt/operationIdから同じcandidateが
  /// 複数回materializeされることをDBレベルで防げていなかった(監査で指摘)。
  /// candidateはtenant全体を通じて一度しかmaterializeされてはならない
  /// (DOC-03 4章「1候補1生成」の本来の意味)ため、workspaceId+candidateIdの
  /// global一意制約を追加する。旧制約は後方互換のため残す(このglobal制約に
  /// 包含されるため実害は無い)。
  @@unique([receiptId, candidateId], map: "materialization_receipt_items_receipt_candidate_uq")
  @@unique([workspaceId, candidateId], map: "materialization_receipt_items_workspace_candidate_uq")
  @@map("materialization_receipt_items")
}

// =====================================================================
// V5-M1-C Atomicity Assessment
// 出典: ISMAY_統合正本仕様書_v5_0.md §11(Atomicity Assessmentと分解提案)。
// DOC-10(DB物理設計書) 3.3節は物理table名`atomicity_assessments`のみを
// 列挙しており(「DESIGNED、DB/API/Worker/UIなし」)、列定義はこのGateで
// 新規に設計する。
//
// [設計方針] §11.3「AssessmentはObservationであり、責任を自動分割しない」
// に従い、この table はCandidate Revisionに対する観測結果を append-only で
// 記録するのみで、他テーブルへの副作用や自動遷移は起こさない
// (FormationSourceAnchorと同じ「Revisionに対する派生観測」パターン)。
// =====================================================================

/// V5-M1-C TBL: formation_atomicity_assessments(Revisionに対する粒度観測。
/// Revisionはimmutableであり、この観測結果もRevision作成時に1回だけ算出する
/// 1:1の派生値として扱う。algorithm versionが将来上がった場合の再評価は
/// このGateのscope外とする(想像で再評価運用を先取りしない)。)
model FormationAtomicityAssessment {
  id               String                     @id @default(uuid())
  workspaceId      String                     @map("workspace_id")
  revisionId       String                     @map("revision_id")
  revision         FormationCandidateRevision @relation(fields: [revisionId, workspaceId], references: [id, workspaceId])
  /// ATOMIC/PROBABLY_ATOMIC/NEEDS_CLARIFICATION/SHOULD_DECOMPOSE/CONTEXT_LIKE
  /// (統合正本§11.1、coreTypes.ts ATOMICITY_ASSESSMENTSと同じ5値)。
  assessment       String
  /// 判定に至った主理由の短いcode(既存reasonCode方式を踏襲)。
  reasonCode       String                     @map("reason_code")
  /// §11.3「使用Evidence」。{code, detail}の配列。
  evidence         Json
  /// アルゴリズム自身の判定に対する確信度(0〜1、候補のAI抽出confidenceとは別物)。
  confidence       Decimal                    @db.Decimal(5, 4)
  /// atomicityAssessment.tsのATOMICITY_ALGORITHM_VERSION。再現性のため
  /// (§11.3「algorithm version」)、算出時のversionをsnapshotする。
  algorithmVersion String                     @map("algorithm_version")
  createdAt        DateTime                   @default(now()) @map("created_at")

  @@unique([revisionId], map: "formation_atomicity_assessments_revision_uq")
  @@index([workspaceId, revisionId])
  @@map("formation_atomicity_assessments")
}

// =====================================================================
// V5-M1-C2A Atomicity Materialize Guard override
// 出典: 2026-08-30確定指示書 Gate M1-C2A「SHOULD_DECOMPOSE/CONTEXT_LIKEは、
// 本人の明示override EventまたはSplit/Merge/Editで解決したRevisionがない限り
// 拒否する。overrideは本人操作、対象Revision固定、reason、occurredAt、
// idempotencyを持つ。無回答や画面離脱をoverride扱いしない。」
// =====================================================================

/// V5-M1-C2A TBL: formation_atomicity_overrides(Revision単位・本人操作のみ)
model FormationAtomicityOverride {
  id          String                     @id @default(uuid())
  workspaceId String                     @map("workspace_id")
  revisionId  String                     @map("revision_id")
  revision    FormationCandidateRevision @relation(fields: [revisionId, workspaceId], references: [id, workspaceId])
  /// override理由の短いcode(既存reasonCode方式を踏襲。本人入力の自由文は
  /// このGateのscopeでは持たない=UIで詳細説明を求めるかは次のGateで検討)。
  reasonCode  String                     @map("reason_code")
  /// DOC-03 4章と同じ「単一必須field」方針。SYSTEM/AIによる自動overrideは
  /// 許容しない(「無回答や画面離脱をoverride扱いしない」という明記の裏返し)。
  actorUserId String                     @map("actor_user_id")
  actorUser   User                       @relation(fields: [actorUserId], references: [id])
  occurredAt  DateTime                   @default(now()) @map("occurred_at")

  /// [R1-02新設・監査是正指示書2026-08-31] Answer/Merge APIと同じidempotency契約。
  /// 「同じkey・同じ内容の再送は同じ結果、内容が違えば拒否」をrequestHashと併せて
  /// 保証する(呼出元route/serviceレベルでのbody内容変更を検知するため)。
  clientEventId String @map("client_event_id")
  /// sessionId/workspaceId/candidateId/expectedRevision/reasonCodeから決定論的に
  /// 算出するSHA-256(atomicityOverride.ts computeOverrideRequestHash)。
  requestHash   String @map("request_hash")

  /// 1 Revisionにつきoverrideは高々1件(業務不変条件)。同一Revisionへの
  /// 再override試行はこの一意制約により既存行の再利用として扱われる
  /// (service層でP2002をcatchしatomicityOverride.tsのRESULT型へ変換する)。
  @@unique([revisionId], map: "formation_atomicity_overrides_revision_uq")
  /// [R1-02新設] idempotency key本体。clientEventIdの再送検知に使う。
  @@unique([workspaceId, clientEventId], map: "formation_atomicity_overrides_workspace_client_uq")
  @@index([workspaceId, revisionId])
  @@map("formation_atomicity_overrides")
}

// =====================================================================
// V5-M1-C2B Candidate MERGE Correction
// 出典: 2026-08-30確定指示書 DEC-MERGE-001「元候補は削除・上書きせず、各候補へ
// MERGED Correction/Decision Eventをappendし、新しいCandidate Identity/
// Revisionを同一transactionで作る。新候補は全親Source Anchorを重複排除して
// 継承し、親candidate/revisionのlineageをDBで照会可能にする。」
// =====================================================================

/// V5-M1-C2B TBL: formation_candidate_lineages(Merge/Split結果の親子関係、
/// DBで照会可能にする。correctionKindは"MERGE"(このGateで実装)/"SPLIT"
/// (M1-C2CでsplitCorrection.tsのevent payloadのみlineageから、この table
/// へ揃える予定、現時点ではSPLIT側はまだこのtableへ書き込んでいない)。
model FormationCandidateLineage {
  id               String                     @id @default(uuid())
  workspaceId      String                     @map("workspace_id")
  childRevisionId  String                     @map("child_revision_id")
  childRevision    FormationCandidateRevision @relation("LineageChildRevision", fields: [childRevisionId, workspaceId], references: [id, workspaceId])
  parentIdentityId String                     @map("parent_identity_id")
  parentIdentity   FormationCandidateIdentity @relation("LineageParentIdentity", fields: [parentIdentityId, workspaceId], references: [id, workspaceId])
  /// 親candidateの「その訂正の対象になった時点のRevision」を固定する
  /// (recordCandidateDecisionの決定Revision固定と同じ設計原則)。
  /// [R1-03是正・監査是正指示書2026-08-31] 以前は(parentRevisionId,workspaceId)の
  /// 2列FKのみで、「このRevisionが本当にparentIdentityId(上のFK)に属するか」を
  /// DBが保証していなかった(application層のtxロジックが常に整合させていたが、
  /// 将来のバグや手動データ投入で不整合が起き得た)。parentRevisionId自体は
  /// 変えず、FK先をFormationCandidateRevisionの(id,candidateId,workspaceId)
  /// 複合uniqueへ変更し、[parentRevisionId, parentIdentityId, workspaceId]の
  /// 3列で参照することで「parentRevisionのcandidateId===parentIdentityId」を
  /// DB制約として強制する。
  parentRevisionId String                     @map("parent_revision_id")
  parentRevision   FormationCandidateRevision @relation("LineageParentRevision", fields: [parentRevisionId, parentIdentityId, workspaceId], references: [id, candidateId, workspaceId])
  /// "MERGE" | "SPLIT"(想像で他の値を追加しない。この2値のみが正本§11.4の
  /// 対象操作)。
  correctionKind   String                     @map("correction_kind")
  createdAt        DateTime                   @default(now()) @map("created_at")

  @@unique([childRevisionId, parentIdentityId], map: "formation_candidate_lineages_child_parent_uq")
  @@index([workspaceId, childRevisionId])
  @@index([workspaceId, parentIdentityId])
  @@map("formation_candidate_lineages")
}

/// V5-M1-C2B TBL: formation_candidate_merge_events(Merge操作そのものの
/// idempotency記録。DEC-MERGE-001「idempotency key + request hash…同一
/// idempotency再送は同じ結果、同一key異payloadは409」)。CandidateDecisionEvent
/// (各親candidateへのMERGED記録)とは別に、「このMerge操作全体」を1行で
/// 表す(materializationReceipt.operationIdと同じ設計思想)。
model FormationCandidateMergeEvent {
  id             String                     @id @default(uuid())
  workspaceId    String                     @map("workspace_id")
  /// [R1-03是正・監査是正指示書2026-08-31] 以前はsessionIdが素のString fieldで、
  /// DB上どのFormationSessionを指すか制約されていなかった(削除済み/別workspaceの
  /// sessionIdを指してもDBが拒否しなかった)。FormationSession側の既存
  /// `formation_sessions_id_workspace_uq`を参照先とする複合FKを追加する。
  sessionId      String                     @map("session_id")
  session        FormationSession           @relation(fields: [sessionId, workspaceId], references: [id, workspaceId])
  clientEventId  String                     @map("client_event_id")
  requestHash    String                     @map("request_hash")
  newCandidateId String                     @map("new_candidate_id")
  newCandidate   FormationCandidateIdentity @relation("MergeEventNewCandidate", fields: [newCandidateId, workspaceId], references: [id, workspaceId])
  actorUserId    String                     @map("actor_user_id")
  actorUser      User                       @relation(fields: [actorUserId], references: [id])
  occurredAt     DateTime                   @default(now()) @map("occurred_at")

  @@unique([workspaceId, clientEventId], map: "formation_candidate_merge_events_workspace_client_uq")
  @@index([workspaceId, sessionId])
  @@map("formation_candidate_merge_events")
}

/// V5-M1-B6B TBL: formation_session_lifecycle_events(defer/dismiss/resume/retry
/// のidempotency記録・append-only audit trail)。
/// 出典: Claude向け ISMAY 69b5a87以降 監査是正・M1-B6完遂・PEM-0連続実装指示
/// (2026-08-31) Gate M1-B6B Session Lifecycle。
///
/// [設計方針] `FormationSessionEvent`(汎用timeline)とは別にこの専用tableを
/// 設けた理由: (1) idempotency契約(clientEventId+requestHash、DEC-MERGE-001と
/// 同じ設計)を持つのはこの4操作(DEFER/DISMISS/RESUME/RETRY)のみであり、
/// 汎用timeline行にidempotency専用列を持たせるとSOURCE_ANCHOR_ATTACHED等の
/// 他Event種別には無関係な列が常に付く。(2) RESUMEが「defer前の状態」を
/// 正確に再現するには、直近のDEFER行のfromStateを機械的に検索できる必要があり、
/// これは汎用timelineのpayload(Json、型無し)を都度parseするより、専用列を
/// 持つ方が安全・高速(想像でJsonのkey名に依存しない)。
model FormationSessionLifecycleEvent {
  id            String           @id @default(uuid())
  workspaceId   String           @map("workspace_id")
  sessionId     String           @map("session_id")
  session       FormationSession @relation(fields: [sessionId, workspaceId], references: [id, workspaceId])
  /// Answer/Merge APIと同じidempotency契約(clientEventId+requestHash)。
  clientEventId String           @map("client_event_id")
  requestHash   String           @map("request_hash")
  /// "DEFER" | "DISMISS" | "RESUME" | "RETRY" | "RESOLVE_REMAINING"(想像で
  /// これ以外の値を追加しない)。[M1-B6C-4新設・2026-09-02指示書§6.4]
  /// RESOLVE_REMAININGはresolveRemaining.tsから使う
  /// (PARTIALLY_CONFIRMED残候補の一括終端決定)。
  action        String
  fromState     String           @map("from_state")
  toState       String           @map("to_state")
  /// DEFER/DISMISS時、本人が任意で入力する理由(統合正本§6.3「理由任意」)。
  reasonCode    String?          @map("reason_code")
  actorUserId   String           @map("actor_user_id")
  actorUser     User             @relation(fields: [actorUserId], references: [id])
  occurredAt    DateTime         @default(now()) @map("occurred_at")

  @@unique([workspaceId, clientEventId], map: "formation_session_lifecycle_events_workspace_client_uq")
  @@index([workspaceId, sessionId, action, occurredAt])
  @@map("formation_session_lifecycle_events")
}

/// V5-M1-B6C-1 TBL: formation_shadow_checkpoints
/// 出典: Claude向け ISMAY c503e72以降 M1-B6C・全残件連続実装指示(2026-08-31)
/// §3 Gate M1-B6C-1「Shadow Reconciliation/Checkpoint」。
///
/// [設計方針] `writeShadowFormationSession`(shadowWrite.ts)はCapture/AiInference
/// 本体transactionの外でbest-effort実行され、従来は失敗を`SHADOW_WRITE_FAILED_IGNORED`
/// として握り潰していた。その結果、Capture=READY/AiInference=成功なのに
/// FormationSessionが永久欠落する状態が起こり得た(指示書§3.1)。
///
/// この table は、本体transaction内(ai/extract.ts persistSuccess)でPENDING行として
/// 必ず1件作成される「Formation shadow投影を実施すべきという事実」の永続記録である。
/// Workerはこの行をclaimしてshadow書込みを実行し、結果(SUCCEEDED/RETRY_WAIT/
/// DEAD_LETTER/CANCELLED)をここへ記録する。これにより、shadow書込みの失敗が
/// 「握り潰されて見えなくなる」のではなく「観測可能な永続状態」になる。
///
/// key設計: `(workspaceId, aiRunId)`一意(指示書§3.2「安定key」)。aiRunIdは
/// ai_runs.idであり、1 AiRunにつきshadow投影対象は最大1回(REALTIME/BATCHいずれの
/// 経路もpersistSuccess経由でここを通る)。
model FormationShadowCheckpoint {
  id                String    @id @default(uuid())
  workspaceId       String    @map("workspace_id")
  captureId         String    @map("capture_id")
  capture           Capture   @relation(fields: [captureId, workspaceId], references: [id, workspaceId])
  aiRunId           String    @map("ai_run_id")
  aiRun             AiRun     @relation(fields: [aiRunId], references: [id])
  /// PENDING/RUNNING/SUCCEEDED/RETRY_WAIT/DEAD_LETTER/CANCELLED(指示書§3.2)。
  status            String    @default("PENDING")
  attempt           Int       @default(0)
  maxAttempts       Int       @default(5) @map("max_attempts")
  /// PENDING/RETRY_WAITの次回試行時刻。RUNNING行がこの時刻を大きく過ぎている場合、
  /// Workerがcrash後の孤立RUNNINGとみなしRETRY_WAITへ回収する(§3.2「crash後に
  /// 安全に再開できる」)。
  nextRunAt         DateTime? @map("next_run_at")
  lastErrorCode     String?   @map("last_error_code")
  lastErrorDigest   String?   @map("last_error_digest")
  /// 作成時点のaiRunId+候補件数+schemaVersionから算出するdrift検知用hash。
  /// claim時に現在のAiInference行から再計算した値と不一致なら、作成後にデータが
  /// 変化した(想定外)とみなしCORRUPTED_CHECKPOINT_DATAでDEAD_LETTERにする
  /// (R1-01/02と同じfail-closed方針。想像で処理を継続しない)。
  requestHash       String    @map("request_hash")
  completedAt       DateTime? @map("completed_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  /// [M1-B6C-4新設・2026-09-01指示書§6.3「retry orchestration」] このAiRunが
  /// FormationSession retryによる新analysis attemptの場合、対象SessionのIDを
  /// 保持する。nullの場合は通常の(新規Session作成)shadow投影。この値を
  /// checkpoint行自体に永続化することで、inline即時実行と後続のreconciliation
  /// worker実行のどちらでも同じ「新規作成 or 追記」の判断を再現できる
  /// (呼び出し元の一時的なJS変数に依存しない)。
  attachToSessionId String?   @map("attach_to_session_id")

  /// 同一AiRunに対するcheckpointの重複作成を防ぐ(idempotency、指示書§3.2)。
  @@unique([workspaceId, aiRunId], map: "formation_shadow_checkpoints_ai_run_uq")
  @@index([status, nextRunAt])
  @@index([workspaceId, captureId])
  @@map("formation_shadow_checkpoints")
}
