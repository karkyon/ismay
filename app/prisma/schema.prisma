/// TBL-016 pem_observations [推論・DB設計書4.5節に準拠]
model PemObservation {
  id             String    @id @default(uuid())
  userId         String    @map("user_id")
  user           User      @relation(fields: [userId], references: [id])
  observationType String   @map("observation_type")
  payload        Json
  validUntil     DateTime? @map("valid_until")
  occurredAt     DateTime  @default(now()) @map("occurred_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  /// [2026-08-24訂正・Phase 0C-2] v4.0 16.3節により論理削除はinsert-onlyの
  /// PemEvidenceDeletionEvent(evidenceDeletion.ts参照)へ移行した。この列自体は
  /// 過去データとの後方互換のため残すが、以後のコードはこの列を読み書きしない
  /// (削除判定はgetDeletedEvidenceIds()を正とする)。
  deletedAt      DateTime? @map("deleted_at")
  /// 新設(2026-08-23・FN-PEM-02対応): observationType="TRANSITION"(生イベント取り込み)の
  /// 冪等性キー。機能別詳細設計書v1.1 13章「PEMObserverはResponsibilityTransitionedを
  /// 購読し、eventIdで重複排除する」に対応。EventLog.idを保持し、@uniqueによる
  /// DB制約で二重取り込みを防ぐ(worker/relay.tsと同じP2002依拠の冪等パターン)。
  /// observationType="OBSERVATION"(集計結果)の行はnull(集計は日次で再計算されるため
  /// 単一イベントに紐付かない)。
  sourceEventLogId String?  @unique @map("source_event_log_id")

  evidenceLinks PemEvidenceLink[]

  @@map("pem_observations")
}

/// TBL-017 pem_hypotheses [推論・DB設計書4.5節に準拠]
/// TBL(PEM Phase 0S) pem_consent_events - PEM同意Ledger(insert-only) [出典: PEMサブシステム統合正本仕様書v4.0 16.1節]
model PemConsentEvent {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  user          User     @relation(fields: [userId], references: [id])
  /// [2026-08-25追加・Completion Gate 1] tenant境界(v4.0 16.1節が要求する
  /// workspaceId)。既存行はworkspace_membersからbackfillした(MVPは1ユーザー1
  /// Workspace前提のため、複数所属時は最初に参加したWorkspaceを採用)。
  workspaceId   String   @map("workspace_id")
  /// PEM_DATA_COLLECTION/PEM_AI_PROCESSING/PEM_PLANNING_APPLICATION/PEM_EXPERIMENT/SENSITIVE_SELF_REPORT
  consentType   String   @map("consent_type")
  /// GRANTED/WITHDRAWN
  action        String
  policyVersion String   @map("policy_version")
  /// [2026-08-25追加] v4.0 16.1節が要求するConsent scope。正式な構造の記載が原本に
  /// 無いため、列のみ用意し現状は常にnull(想像で構造を作らない)。
  scope         Json?
  /// ONBOARDING/SETTINGS
  source        String
  occurredAt    DateTime @default(now()) @map("occurred_at")

  @@index([userId, consentType])
  @@index([workspaceId])
  @@map("pem_consent_events")
}

/// TBL(PEM Completion Gate 1) pem_metric_consent_events - metric単位OFFのLedger
/// [出典: PEMサブシステム統合正本仕様書v4.0 16.2節「metric OFF」]
/// insert-only。GRANTED=そのmetricの利用を許可、WITHDRAWN=そのmetricだけを無効化。
/// イベントが1件も無いmetricは、metricDefinitionRegistry.tsの登録有無
/// (isMetricEnabledByDefault)がデフォルト値になる。
model PemMetricConsentEvent {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  user          User     @relation(fields: [userId], references: [id])
  workspaceId   String   @map("workspace_id")
  metricKey     String   @map("metric_key")
  /// GRANTED/WITHDRAWN
  action        String
  policyVersion String   @map("policy_version")
  /// ONBOARDING/SETTINGS
  source        String
  occurredAt    DateTime @default(now()) @map("occurred_at")

  @@index([userId, metricKey])
  @@map("pem_metric_consent_events")
}

/// TBL(PEM Phase 0A) responsibility_execution_events - Execution Event Ledger本体 [出典: PEMサブシステム統合正本仕様書v4.0 5章]
/// TBL(PEM Phase 0A) responsibility_execution_events - Execution Event Ledger本体
/// [出典: PEMサブシステム統合正本仕様書v4.0 5章]
/// [2026-08-24改訂・Phase 0A是正2] 5.3節Eventスキーマの必須列・複合unique・tenant複合FKを
/// 追加した。ただし列を追加しただけで、実際に値を計算・伝播するアプリケーションロジックが
/// 伴わない項目がある(clockOffset*・sourceDeviceId・clientEventId等。本ファイル冒頭の
/// パッチスクリプトdocstring参照)。列の存在と機能の完成度は別である。
model ResponsibilityExecutionEvent {
  id                           String   @id @default(uuid())
  workspaceId                  String   @map("workspace_id")
  subjectUserId                String   @map("subject_user_id")
  actorType                    String   @map("actor_type")
  actorUserId                  String?  @map("actor_user_id")
  /// [新設] SYSTEM/WORKER由来イベントを生成した場合のサービス識別子。
  /// 現状USER操作のみのため常にnull(v4.0 4章)。
  actorServiceId                String?  @map("actor_service_id")
  /// [新設] AI Agent由来イベントを生成した場合のAgent識別子。現状常にnull。
  actorAgentId                   String?  @map("actor_agent_id")
  /// [新設] 代理操作を行った場合、代理権限を与えた本人のuserId。現状代理操作機能が
  /// 無いため常にnull。
  delegatedByUserId              String?  @map("delegated_by_user_id")
  /// [新設] 認証・認可判断の追跡ID(v4.0 4章)。PemAuthorizationContext.authenticationContextId
  /// をそのまま保存する。[既知の簡略化] 現状のtransitions/route.tsは真の認証コンテキストID
  /// ではなくuserIdを暫定的に渡しているため、値の質はその制約を引き継ぐ。
  authenticationContextId        String?  @map("authentication_context_id")
  /// [新設] API要求単位の追跡ID(v4.0 5.3節)。x-request-idヘッダがあれば優先、
  /// 無ければ要求ごとにrandomUUID()で発行する(transitions/route.ts参照)。
  requestId                      String   @map("request_id")
  responsibilityId             String   @map("responsibility_id")
  /// [2026-08-24改訂] 単一列(responsibilityId)参照から、(responsibilityId, workspaceId)の
  /// 複合参照へ変更した。EventのworkspaceIdとResponsibilityのworkspaceIdが常に一致する
  /// ことをDBレベルで保証する(v4.0 4.1節「tenantを跨ぐFK参照…を禁止する」)。
  responsibility                Responsibility @relation(fields: [responsibilityId, workspaceId], references: [id, workspaceId])
  /// START/RESUME/INTERRUPT/DEFER/SWITCH_OUT/COMPLETE/REOPEN/RESPONSIBILITY_ABANDON/AUTO_PAUSE_CONFIRMED
  eventType                     String   @map("event_type")
  fromState                     String   @map("from_state")
  toState                       String   @map("to_state")
  responsibilityVersionBefore   Int      @map("responsibility_version_before")
  responsibilityVersionAfter    Int      @map("responsibility_version_after")
  responsibilitySequence        Int      @map("responsibility_sequence")
  /// [新設] 欠番・commit順不一致を許容する参考識別子(v4.0 5.3節)。意味的順序・配送順・
  /// commit順の保証には使わない(responsibilitySequenceが意味的順序の正)。DB側の
  /// シーケンスで採番する。
  globalSequence                 BigInt   @unique(map: "ree_global_sequence_uq") @default(autoincrement()) @map("global_sequence")
  source                        String
  /// [新設] 端末識別子。オフライン同期・複数端末競合検知は未実装のため常にnull。
  sourceDeviceId                  String?  @map("source_device_id")
  /// [新設] 端末側の冪等キー(オフライン再送検知用)。未実装のため常にnull。
  clientEventId                   String?  @map("client_event_id")
  /// [新設] 端末側の順序番号。未実装のため常にnull。
  clientSequence                   BigInt?  @map("client_sequence")
  /// [改訂] v4.0 6.1節「SYSTEM/WORKER由来イベントではclientOccurredAtをnullとし、
  /// サーバー時刻を採用する」に合わせ必須→任意化した(現状はUSER操作のみのため
  /// 実質常に値が入るが、将来SYSTEM/WORKER経路が実装された際に備える)。
  clientOccurredAt              DateTime? @map("client_occurred_at")
  serverRecordedAt              DateTime @default(now()) @map("server_recorded_at")
  effectiveOccurredAt           DateTime @map("effective_occurred_at")
  occurredAtQuality             String   @map("occurred_at_quality")
  /// [新設] 既知のclock offset(秒)。オフライン同期のclock補正は未実装のため常にnull。
  clockOffsetSeconds              Int?     @map("clock_offset_seconds")
  clockOffsetMeasuredAt           DateTime? @map("clock_offset_measured_at")
  idempotencyKey                String   @map("idempotency_key")
  /// [新設] 同一idempotencyKeyでpayloadが異なる場合の409判定に使う要求本文のhash
  /// (v4.0 5.5節)。transitions/route.tsがsha256で計算して渡す。
  requestPayloadHash              String   @map("request_payload_hash")
  schemaVersion                 String   @map("schema_version")
  correlationId                 String?  @map("correlation_id")
  causationId                   String?  @map("causation_id")
  /// [改訂] 従来Json?(任意)だったが、v4.0 5.3節はJson(必須)を要求する。
  /// 既存null行はマイグレーションで{}へbackfillし、NOT NULL化した。
  metadata                      Json     @default("{}")
  /// [新設] 行の物理作成時刻。従来欠落していた。
  createdAt                      DateTime @default(now()) @map("created_at")

  /// [改訂] tenantId(workspaceId)を含む複合uniqueへ変更(v4.0 5.3節、批評4.5対応)。
  /// [2026-08-24再修正] 3つの@@unique全てに明示的なmap名を付与した。理由:
  /// Prismaの自動生成制約名は「テーブル名+全フィールド名+_key」だが、本モデルは
  /// workspaceId/subjectUserIdで始まる長いフィールド名の組み合わせが複数あり、
  /// PostgreSQLの識別子長制限(63バイト)で切り詰められた結果、idempotencyKey用と
  /// clientEventId用の自動生成名が衝突しPrisma検証エラー(P1012)になった
  /// (実サーバーでの実行結果から判明)。migration.sqlで実際に使っている
  /// 短い制約名と一致させる。
  @@unique([workspaceId, responsibilityId, responsibilitySequence], map: "ree_workspace_responsibility_sequence_uq")
  @@unique([workspaceId, subjectUserId, idempotencyKey], map: "ree_idempotency_uq")
  /// [新設] v4.0 5.3節が要求する複合unique(clientEventIdは任意列のため、
  /// 複数行がnullの場合はPostgreSQLの既定動作によりunique違反にならない)。
  @@unique([workspaceId, subjectUserId, clientEventId], map: "ree_workspace_subject_client_event_uq")
  @@index([responsibilityId])
  @@map("responsibility_execution_events")
}

model PemHypothesis {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id])
  statement   String
  sampleSize  Int       @map("sample_size")
  windowFrom  DateTime  @map("window_from")
  windowTo    DateTime  @map("window_to")
  confidence  Decimal   @db.Decimal(4, 3)
  validUntil  DateTime? @map("valid_until")
  /// UNREVIEWED(未評決)/AGREED(合っている)/DISAGREED(違う)/PARTIALLY_AGREED(部分的に合っている)
  /// [出典: PEMサブシステム統合正本仕様書v4.0 12.2節]
  /// [2026-08-24訂正・Phase 0C-3] 従来はCONFIRMED/REJECTED/TEMPORARY/PENDINGという
  /// 別語彙だった(PHASE_0G_COMPATIBILITY_LEDGER.md参照)。TEMPORARY(今だけ一時的)は
  /// 評決ではなくTemporary State側の概念(Phase 1で新設予定、未着手)のため、新語彙には
  /// 対応する値が無い。既存TEMPORARY行はUNREVIEWEDへ移行し、元の値はlegacyUserVerdict
  /// (下記)へ退避した。「今後使わない」は引き続き本レコードのdeletedAt(forget操作、
  /// このモデルに限りv4.0 16.3節のinsert-only化対象外。衝突台帳未フラグ)として表現する。
  userVerdict String    @default("UNREVIEWED") @map("user_verdict")
  /// [新設・Phase 0C-3] マイグレーション前のuserVerdict値の退避列(CONFIRMED/REJECTED/
  /// TEMPORARY/PENDING)。特にTEMPORARYだった仮説をPhase 1のTemporary State実装時に
  /// 洗い出せるようにするため削除しない。新規作成される行では常にnull。
  legacyUserVerdict String? @map("legacy_user_verdict")
  /// 新設(2026-08-23・FN-PEM-03対応): AI-07自動生成時のみ設定する集計指標キー
  /// (例: "DEFER_RATE_BY_ESTIMATE"、lib/pem.tsのOBSERVATION.payload.metricと対応)。
  /// 「本人がREJECTした仮説は同じ根拠だけで再提案しない」(機能別詳細設計書v1.1 13章)を
  /// 満たすため、再生成前に同一metricの既存仮説を確認する用途に使う。初回対話由来(null)は対象外。
  sourceMetric String?   @map("source_metric")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  evidenceLinks PemEvidenceLink[]

  @@map("pem_hypotheses")
}

/// TBL-018 pem_evidence_links - PEMと証拠参照（責任に従属）[推論]
model PemEvidenceLink {
  id               String          @id @default(uuid())
  pemObservationId String?         @map("pem_observation_id")
  pemObservation   PemObservation? @relation(fields: [pemObservationId], references: [id])
  pemHypothesisId  String?         @map("pem_hypothesis_id")
  pemHypothesis    PemHypothesis?  @relation(fields: [pemHypothesisId], references: [id])
  evidenceId       String          @map("evidence_id")
  evidence         Evidence        @relation(fields: [evidenceId], references: [id])
  createdAt        DateTime        @default(now()) @map("created_at")

  @@map("pem_evidence_links")
}

/// [2026-08-24改訂・Phase 0E] FN-PEM-01 初回対話のConversationState永続化。
/// 出典: PEMサブシステム統合正本仕様書v4.0 11章、
/// PHASE_0G_COMPATIBILITY_LEDGER.md「PemOnboardingConversation.userId @unique」行。
/// 従来は1ユーザー1件固定(userIdがunique)だったが、v4.0はINITIAL/RECALIBRATION/
/// MAJOR_CHANGEを複数履歴として許可するため、unique制約を外し複数行を許容する。
/// [スコープ] 本改訂はデータモデルのみ。RECALIBRATION/MAJOR_CHANGEを実際にいつ・
/// どうトリガーするかの業務ロジックは未実装(v4.0 11章の該当詳細が未確認のため、
/// 想像で実装しない判断)。現状は新規対話を常にconversationKind="INITIAL"で作成する
/// (lib/ai/pemOnboarding.tsのfindOrCreateCurrentConversation参照)。
model PemOnboardingConversation {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id])
  /// INITIAL/RECALIBRATION/MAJOR_CHANGE(v4.0 11章)。既存データはbackfillでINITIALとする。
  conversationKind String @default("INITIAL") @map("conversation_kind")
  /// ROLE/CURRENT_LOAD/FIXED_CONSTRAINTS/EXECUTION_CONTEXT/VALUES/REVIEW/DONE [推論]
  state     String    @default("ROLE")
  /// {role: "assistant"|"user", content: string, at: string}[] の対話履歴全体
  messages  Json      @default("[]")
  /// 本人未確認のFACT候補({statement, evidenceMessageIndex}[])。REVIEW段階で提示し、
  /// 確認されたものだけpem_observations(observationType="FACT")へ昇格させる。
  proposedFacts       Json @default("[]") @map("proposed_facts")
  proposedHypotheses  Json @default("[]") @map("proposed_hypotheses")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  completedAt DateTime? @map("completed_at")

  @@index([userId, createdAt])
  @@map("pem_onboarding_conversations")
}

/// 新設(2026-08-23・FN-PEM-03対応): 週次レビュー(AI-08)のキャッシュ。
/// API-PEM-03(GET /reviews/weekly)は「直近の完了済み週のレビューが無ければその場で
/// AI生成し、あれば再利用する」設計のため、週単位で1行(userId, weekStart)に保存する。
/// TBL番号未採番([推論]。DB設計書のTBL-016〜018には無いが、AI-08「原データ変更不可」を
/// 満たしつつ毎回AI再呼び出しするとコスト目標(月額¥300〜500)に反するため新設)。
model PemWeeklyReview {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id])
  /// 週境界はlib/cycle.tsのCycleと同じ月曜0:00〜翌月曜0:00(排他的)。
  weekStart   DateTime @map("week_start")
  weekEnd     DateTime @map("week_end")
  /// {fulfilledCount, stalledCount, estimateErrorPercent, strengthStatement,
  ///  experimentSuggestion, generatedByAi}
  summaryJson Json     @map("summary_json")
  generatedAt DateTime @default(now()) @map("generated_at")

  @@unique([userId, weekStart])
  @@map("pem_weekly_reviews")
}



/// TBL(PEM Phase 0C) pem_evidence_deletion_events - Evidence削除Ledger(insert-only)
/// [出典: PEMサブシステム統合正本仕様書v4.0 16.3節]
model PemEvidenceDeletionEvent {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  user         User     @relation(fields: [userId], references: [id])
  /// 現時点はPEM_OBSERVATIONのみ(PHASE_0G_COMPATIBILITY_LEDGER.md参照)。
  targetType   String   @map("target_type")
  targetId     String   @map("target_id")
  /// EXCLUDED_FROM_USE/REDACTED/ANONYMIZED/CRYPTOGRAPHICALLY_ERASED/
  /// PHYSICALLY_DELETED/LEGALLY_RETAINED(coreTypes.ts EvidenceDeletionMode)
  deletionMode String   @map("deletion_mode")
  reason       String?
  occurredAt   DateTime @default(now()) @map("occurred_at")

  @@index([userId, targetType, targetId])
  @@map("pem_evidence_deletion_events")
}

/// TBL(PEM Phase 0B-2) execution_session_identities - 論理Session識別子
/// [出典: PEMサブシステム統合正本仕様書v4.0 7.2節]
/// 論理Session1つにつき1行。startEventId(START/RESUMEイベント)で一意に定まる。
model ExecutionSessionIdentity {
  id                String   @id @default(uuid())
  workspaceId       String   @map("workspace_id")
  subjectUserId     String   @map("subject_user_id")
  responsibilityId  String   @map("responsibility_id")
  /// [v4.0 4.1節] tenant跨ぎ参照をDBで禁止する複合FK(ResponsibilityExecutionEvent
  /// と同じパターン。Phase 0A是正2参照)。
  responsibility    Responsibility @relation(fields: [responsibilityId, workspaceId], references: [id, workspaceId])
  /// このSessionを開始したResponsibilityExecutionEvent.id(START/RESUME)。
  startEventId      String   @map("start_event_id")
  createdAt         DateTime @default(now()) @map("created_at")

  revisions ExecutionSessionRevision[]

  @@unique([workspaceId, startEventId], map: "esi_workspace_start_event_uq")
  @@index([responsibilityId])
  @@map("execution_session_identities")
}

/// TBL(PEM Phase 0B-2) execution_session_revisions - Session内容のinsert-only履歴
/// [出典: PEMサブシステム統合正本仕様書v4.0 7.2節]
/// insert-only。内容が変わった場合のみ新Revisionを追記し、旧行はUPDATEしない
/// (v4.0「旧版をSUPERSEDEDへ直接更新せず」)。「現在版」はsessionIdentityId内で
/// 最大のrevision番号を持つ行として投影で決定する(SUPERSEDEDは独立したstatus値
/// として保存しない)。
model ExecutionSessionRevision {
  id                     String    @id @default(uuid())
  sessionIdentityId      String    @map("session_identity_id")
  sessionIdentity        ExecutionSessionIdentity @relation(fields: [sessionIdentityId], references: [id])
  revision               Int
  /// fold algorithm(sessionProjection.ts computeExecutionSessions)自体の版。
  derivationVersion      String    @map("derivation_version")
  /// OPEN/CLOSED_CONFIRMED/CLOSED_UNCONFIRMED(v4.0 7.1節・7.3節。値集合は原本に
  /// 明記が無いため本文の記述から導出。sessionPersistence.ts参照)。
  status                 String
  startedAt              DateTime  @map("started_at")
  endedAt                DateTime? @map("ended_at")
  /// INTERRUPT/DEFER/SWITCH_OUT/COMPLETE/AUTO_PAUSE_CONFIRMED/TIMEOUT。
  endReason              String?   @map("end_reason")
  rawElapsedSeconds      Int       @map("raw_elapsed_seconds")
  /// Activity Segmentによる補正後の実作業秒数(v4.0 7.4節、未実装のため常にnull)。
  correctedActiveSeconds Int?      @map("corrected_active_seconds")
  /// [既知の簡略化] Activity Evidence Ledger未実装のため常に"EXECUTION_LEDGER_ONLY"。
  measurementMode        String    @map("measurement_mode")
  measurementQuality     String    @map("measurement_quality")
  qualityReasonCodes     Json      @default("[]") @map("quality_reason_codes")
  timeZoneId             String?   @map("time_zone_id")
  utcOffsetMinutes       Int?      @map("utc_offset_minutes")
  supersedesRevisionId   String?   @map("supersedes_revision_id")
  createdAt              DateTime  @default(now()) @map("created_at")

  @@unique([sessionIdentityId, revision], map: "esr_identity_revision_uq")
  @@map("execution_session_revisions")
}

/// TBL(PEM Phase 0C-1-2) reason_prompts - Reason Prompt識別子
/// [出典: PEMサブシステム統合正本仕様書v4.0 8.2節]
/// 「同一trigger Eventに対するPromptは1件とする」。1 trigger Event = 1 Prompt。
model ReasonPrompt {
  id             String   @id @default(uuid())
  workspaceId    String   @map("workspace_id")
  subjectUserId  String   @map("subject_user_id")
  /// このPromptを発生させたResponsibilityExecutionEvent.id
  /// (INTERRUPT/DEFER/REOPEN/RESPONSIBILITY_ABANDON等、requiresReasonPrompt=trueのEvent)。
  /// IDは常に同一トランザクション内で自分が作成した行のものであり(ユーザー入力から
  /// 直接受け取らない)、tenant跨ぎ参照のリスクが無いため単純な単一列FKとする
  /// (ResponsibilityExecutionEvent.idはグローバルに一意なUUID)。
  triggerEventId String   @unique(map: "reason_prompts_trigger_event_id_uq") @map("trigger_event_id")
  createdAt      DateTime @default(now()) @map("created_at")

  stateEvents ReasonPromptStateEvent[]
  answers     ExecutionReasonAnswer[]

  @@map("reason_prompts")
}

/// TBL(PEM Phase 0C-1-2) reason_prompt_state_events - Prompt状態のinsert-only履歴
/// [出典: PEMサブシステム統合正本仕様書v4.0 8.2節]
/// TRIGGERED/DELIVERED/DISPLAYED/ANSWERED/SKIPPED/EXPIRED/DELIVERY_FAILED。
/// 「現在状態と履歴を分離し、矛盾する同時状態を許さない」→現在状態は最新行からの
/// 投影で決定する(Phase 0S Consentと同じinsert-only+投影パターン)。
/// [既知の簡略化] 現行UIはreason入力を遷移リクエストと同時に送るため、
/// DELIVERED/DISPLAYED/EXPIRED/DELIVERY_FAILEDへは到達しない(TRIGGERED直後に
/// ANSWEREDまたはSKIPPEDのみ記録する。reasonLedger.ts参照)。
model ReasonPromptStateEvent {
  id         String   @id @default(uuid())
  promptId   String   @map("prompt_id")
  prompt     ReasonPrompt @relation(fields: [promptId], references: [id])
  state      String
  occurredAt DateTime @default(now()) @map("occurred_at")

  @@index([promptId])
  @@map("reason_prompt_state_events")
}

/// TBL(PEM Phase 0C-1-2) execution_reason_answers - Execution Reasonの回答
/// [出典: PEMサブシステム統合正本仕様書v4.0 8.3節]
/// insert-only。「自由記述からAIが分類したReasonと本人選択Reasonを分離する」ため、
/// reasonCode(本人選択)とaiClassifiedReasonCode(AI分類)を別列にする。
/// [既知の簡略化] 現行UIには構造化選択肢UIも自由記述AI分類パイプラインも無いため、
/// reasonCode/aiClassifiedReasonCodeは常にnull、freeTextのみが実際に埋まる。
model ExecutionReasonAnswer {
  id                     String   @id @default(uuid())
  workspaceId            String   @map("workspace_id")
  subjectUserId          String   @map("subject_user_id")
  promptId               String   @map("prompt_id")
  prompt                 ReasonPrompt @relation(fields: [promptId], references: [id])
  triggerEventId         String   @map("trigger_event_id")
  /// 本人が選択したReason種別コード。現行UIには構造化選択肢が無いため常にnull。
  reasonCode             String?  @map("reason_code")
  /// 自由記述からAIが分類したReason種別コード。分類パイプライン未実装のため常にnull。
  aiClassifiedReasonCode String?  @map("ai_classified_reason_code")
  freeText               String?  @map("free_text")
  structuredDetail       Json?    @map("structured_detail")
  questionVersion        String   @map("question_version")
  /// 訂正時、旧回答を指す(insert-only revision chain、v4.0 8.1節と同じ考え方)。
  /// 現状回答訂正UIが無いため常にnull。
  revisionOfAnswerId     String?  @map("revision_of_answer_id")
  answeredAt             DateTime @map("answered_at")
  createdAt              DateTime @default(now()) @map("created_at")

  @@index([promptId])
  @@map("execution_reason_answers")
}

/// TBL(PEM Phase 0E-2) bootstrap_assertions - Bootstrap Assertion
/// [出典: PEMサブシステム統合正本仕様書v4.0 11章]
/// insert-only。SELF_REPORT/INITIAL_HYPOTHESIS/DECLARED_CONSTRAINT/
/// INTERVENTION_PREFERENCEを区別する。「AssertionとsourceAnswerを中間テーブルで
/// 結ぶ」とあるが、現行の初回対話には構造化Answerが存在しない(自由対話形式)ため、
/// 代わりに昇格元のPemObservation(FACT)/PemHypothesisへ直接参照する
/// (最も近い誠実な代替。詳細は本パッチのdocstring参照)。
/// [現状の制約] SELF_REPORT/INITIAL_HYPOTHESISのみ、初回対話のREVIEW確認完了時に
/// 実際に作成される。DECLARED_CONSTRAINT/INTERVENTION_PREFERENCEはそれを生成する
/// UI・フローが無いため、型としては用意するが未使用。
model BootstrapAssertion {
  id                      String    @id @default(uuid())
  userId                  String    @map("user_id")
  user                    User      @relation(fields: [userId], references: [id])
  /// SELF_REPORT/INITIAL_HYPOTHESIS/DECLARED_CONSTRAINT/INTERVENTION_PREFERENCE
  assertionType           String    @map("assertion_type")
  statement               String
  /// このAssertionの根拠となったPemObservation(FACT)。SELF_REPORT型のみ設定。
  sourceObservationId     String?   @map("source_observation_id")
  /// このAssertionの根拠となったPemHypothesis。INITIAL_HYPOTHESIS型のみ設定。
  sourceHypothesisId      String?   @map("source_hypothesis_id")
  /// 由来する初回対話。
  conversationId          String?   @map("conversation_id")
  /// ACTIVE/EXPIRED/SUPERSEDED/WITHDRAWN [推論。v4.0は「status及びsupersession」と
  /// のみ記載し正式な値集合の明記が無いため、Hypothesis状態(12.2節)の考え方に
  /// 揃えて導出した]。
  status                  String    @default("ACTIVE")
  expiresAt               DateTime? @map("expires_at")
  /// insert-only revision chain。新Assertionがこれを置き換える場合、新側の
  /// supersedesAssertionIdに旧AssertionのIDを入れる(旧行はUPDATEしない)。
  supersedesAssertionId   String?   @map("supersedes_assertion_id")
  createdAt               DateTime  @default(now()) @map("created_at")

  @@index([userId, assertionType])
  @@map("bootstrap_assertions")
}

/// TBL-019 evidences - 完了等の証拠候補 [推論]
model Evidence {
  id               String          @id @default(uuid())
  responsibilityId String?         @map("responsibility_id")
  responsibility   Responsibility? @relation(fields: [responsibilityId], references: [id])
  sourceType       String          @map("source_type")
  sourceRef        String?         @map("source_ref")
  capturedAt       DateTime?       @map("captured_at")
  confidence       Decimal?        @db.Decimal(4, 3)
  /// CANDIDATE/CONFIRMED/REJECTED [推論]
  status           String          @default("CANDIDATE")
  createdAt        DateTime        @default(now()) @map("created_at")

  pemEvidenceLinks PemEvidenceLink[]

  @@map("evidences")
}

