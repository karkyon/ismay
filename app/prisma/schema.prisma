/// TBL-014 ai_inferences
model AiInference {
  id             String    @id @default(uuid())
  captureId      String    @map("capture_id")
  capture        Capture   @relation(fields: [captureId], references: [id])
  aiRunId        String    @map("ai_run_id")
  aiRun          AiRun     @relation(fields: [aiRunId], references: [id])
  /// RESPONSIBILITY/RELATION/DEADLINE等
  inferenceType  String    @map("inference_type")
  payload        Json
  evidenceSpans  Json      @map("evidence_spans")
  confidence     Decimal   @db.Decimal(4, 3)
  /// PENDING/ACCEPTED/EDITED/REJECTED/HELD/EXPIRED (用語・状態・コード定義書v1.1 5章に準拠。
  /// 従来コメントはHELDが抜けていたため本パッチで訂正)
  decision       String    @default("PENDING")
  /// 楽観ロック(API・イベント設計書v1.1 4.2節 expectedInferenceVersion対応)。[新設]
  version        Int       @default(0)
  decidedById    String?   @map("decided_by")
  decidedAt      DateTime? @map("decided_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@map("ai_inferences")
}

/// TBL-015 ai_runs - モデル実行・費用・結果 [推論]
model AiRun {
  id             String    @id @default(uuid())
  captureId      String?   @map("capture_id")
  capture        Capture?  @relation(fields: [captureId], references: [id])
  /// 新設(2026-08-23・FN-PEM系対応): Captureに紐付かないAI呼び出し(PEM対話・仮説生成・
  /// 週次レビュー)のコスト集計用。captureIdがある行はcapture.workspaceId経由で辿れるが、
  /// PEM呼び出しはCaptureを持たないため、admin/ai-usage APIの集計から漏れないよう
  /// 直接workspaceIdを持たせる(MVPは1ユーザー=1 Workspace固定のため矛盾は生じない)。
  workspaceId    String?   @map("workspace_id")
  provider       String
  model          String
  promptVersion  String    @map("prompt_version")
  schemaVersion  String    @map("schema_version")
  inputTokens    Int?      @map("input_tokens")
  outputTokens   Int?      @map("output_tokens")
  costMicros     BigInt?   @map("cost_micros")
  latencyMs      Int?      @map("latency_ms")
  /// PENDING/SUCCEEDED/FAILED [推論]
  status         String    @default("PENDING")
  errorCode      String?   @map("error_code")
  /// 新設(2026-08-21): Anthropic Batch API経由の実行はtrue(料金は50%引きで
  /// costMicros算出済み)。レポート・監査用に区別できるようにする。
  batch          Boolean   @default(false)
  startedAt      DateTime  @default(now()) @map("started_at")
  finishedAt     DateTime? @map("finished_at")

  inferences AiInference[]

  @@map("ai_runs")
}

/// 新設: pgvector Embedding。DB設計書v1.1 7章「検索・Embedding」に対応。TBL番号未採番
model ResponsibilityEmbedding {
  responsibilityId String         @id @map("responsibility_id")
  responsibility   Responsibility @relation(fields: [responsibilityId], references: [id], onDelete: Cascade)
  workspaceId      String         @map("workspace_id")
  domainId         String         @map("domain_id")
  modelVersion     String         @map("model_version")
  /// pgvector型。previewFeatures=postgresqlExtensions前提でPrismaは型検証をスキップする
  embedding        Unsupported("vector(1536)")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  @@index([workspaceId, domainId])
  @@map("responsibility_embeddings")
}

/// 新設: MOD-10 Admin / MOD-06 AI Gateway。FR-AI-07「AIモデルを交換可能にする」を
/// 抽出(FN-AI-01)以外の能力(Embedding、将来のPEM助言)にも拡張し、管理画面から
/// Workspace単位で使用事業者を切り替え可能にする。APIキー自体は環境変数管理のまま
/// (インフラ・運用設計書v1.1の環境ごとの秘密分離方針に従う)、本テーブルは
/// 「どの登録済みプロバイダーを使うか」の選択のみを保持する。
model AiProviderConfig {
  id          String    @id @default(uuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  /// EXTRACTION(FN-AI-01)/EMBEDDING(FN-GR-01)/PEM_ADVICE(FN-PEM-03、将来)
  capability  String
  /// registry.tsに登録されたプロバイダーキー(例: "anthropic","openai")
  providerKey String    @map("provider_key")
  modelName   String?   @map("model_name")
  updatedById String    @map("updated_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([workspaceId, capability])
  @@map("ai_provider_configs")
}

/// 新設: AIプロバイダーAPIキー(暗号化保存)。2026-08-20カルキョンさんの指示
/// 「APIキー登録や切り替えを明確にどのモデルで適用するか切り替えを容易にしろ」に対応。
/// providerKey(事業者単位。例: "anthropic","openai")ごとに1件。同じ事業者を複数の
/// capability(EXTRACTION/EMBEDDING等)で使い回せるよう、AiProviderConfigとは別テーブルにした。
/// 暗号化方式はTOTP秘密鍵(TBD-17暫定方針)と同じAES-256-GCM、鍵は別環境変数
/// (AI_CREDENTIAL_ENCRYPTION_KEY)で分離する(MFA用鍵とは用途混在させない)。
model AiProviderCredential {
  id             String    @id @default(uuid())
  workspaceId    String    @map("workspace_id")
  workspace      Workspace @relation(fields: [workspaceId], references: [id])
  /// registry.tsのプロバイダーキー(例: "anthropic","openai")と対応
  providerKey    String    @map("provider_key")
  encryptedApiKey String   @map("encrypted_api_key")
  /// UI表示用。キー末尾4文字のみ保持(全体は復号しないと分からないようにする)
  last4          String    @map("last4")
  updatedById    String    @map("updated_by")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@unique([workspaceId, providerKey])
  @@map("ai_provider_credentials")
}

